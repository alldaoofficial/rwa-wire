---
import BaseLayout from "@/layouts/BaseLayout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<BaseLayout title="Growth Analytics — RWA Wire" description="Private RWA Wire growth analytics dashboard.">
<div class="wire-container py-10 sm:py-14">
<header class="border-b border-line pb-8"><p class="data-label text-wire">RWA Wire // Internal</p><h1 class="mt-2 font-serif text-4xl text-ink sm:text-5xl">Growth Analytics</h1><p class="mt-3 text-sm text-ink-muted">Private product signals from first-party interaction events.</p></header>
<section id="setup" class="hidden mt-10 border border-line bg-surface p-6"><p class="data-label text-wire">Setup required</p><p class="mt-3 text-sm text-ink-muted">The public Supabase connection variables are not configured for this build yet.</p></section>
<section id="login" class="mx-auto mt-14 max-w-lg border border-line bg-surface p-6 sm:p-8"><p class="data-label text-wire">Admin access</p><h2 class="mt-2 font-serif text-2xl text-ink">Sign in to the desk</h2><p class="mt-3 text-sm text-ink-muted">Enter the authorized admin email. Supabase will send a one-time secure sign-in link.</p><input id="email" type="email" autocomplete="email" placeholder="Admin email" class="mt-5 w-full border border-line bg-bg px-4 py-3 text-sm text-ink outline-none focus:border-wire"><button id="login-btn" class="mt-3 w-full bg-wire px-4 py-3 text-[11px] font-semibold uppercase tracking-[.1em] text-bg">Send secure link</button><p id="status" class="mt-3 text-xs text-ink-muted"></p></section>
<section id="dashboard" class="hidden mt-8"><div class="flex flex-wrap items-center justify-between gap-3"><p id="updated" class="font-mono text-[9px] uppercase tracking-[.08em] text-ink-muted"></p><div class="flex gap-1"><button data-days="1" class="range border border-line px-3 py-1.5 text-[9px] text-ink-muted">1D</button><button data-days="7" class="range border border-wire px-3 py-1.5 text-[9px] text-wire">7D</button><button data-days="30" class="range border border-line px-3 py-1.5 text-[9px] text-ink-muted">30D</button><button id="logout" class="ml-2 border border-line px-3 py-1.5 text-[9px] text-ink-muted">SIGN OUT</button></div></div><div class="mt-5 grid grid-cols-2 gap-px border border-line bg-line lg:grid-cols-5">{['Events','Searches','Zero results','Telegram','Market'].map((x,i)=><div class="bg-bg p-4"><p class="data-label">{x}</p><p id={`k-${i}`} class="mt-2 font-mono text-2xl text-ink">—</p></div>)}</div><div class="mt-5 grid gap-5 lg:grid-cols-2"><div class="border border-line p-5"><p class="data-label text-wire">Top searches</p><div id="top-searches" class="mt-4"></div></div><div class="border border-line p-5"><p class="data-label text-wire">Zero-result searches</p><div id="zero-searches" class="mt-4"></div></div><div class="border border-line p-5 lg:col-span-2"><p class="data-label text-wire">Most clicked content</p><div id="top-content" class="mt-4"></div></div><div class="border border-line p-5 lg:col-span-2"><p class="data-label text-wire">Event mix</p><div id="event-mix" class="mt-4"></div></div></div></section>
</div>
<script define:vars={{ supabaseUrl, supabaseKey }}>
import { createClient } from '@supabase/supabase-js';
const setup=document.getElementById('setup'),login=document.getElementById('login'),dashboard=document.getElementById('dashboard'),status=document.getElementById('status');
if(!supabaseUrl||!supabaseKey){setup?.classList.remove('hidden');login?.classList.add('hidden')}else{
 const sb=createClient(supabaseUrl,supabaseKey);let days=7;
 const esc=(s)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const list=(id,rows,empty='No data yet.')=>{const el=document.getElementById(id);if(el)el.innerHTML=rows?.length?rows.map((x,i)=>`<div class="flex gap-3 border-b border-line/70 py-2.5"><span class="w-5 font-mono text-[9px] text-ink-muted">${i+1}</span><span class="min-w-0 flex-1 truncate text-xs text-ink">${esc(x.label)}</span><span class="font-mono text-xs text-wire">${x.value}</span></div>`).join(''):`<p class="py-4 text-xs text-ink-muted">${empty}</p>`};
 async function load(){const {data:{session}}=await sb.auth.getSession();if(!session){login?.classList.remove('hidden');dashboard?.classList.add('hidden');return}const {data,error}=await sb.rpc('get_growth_dashboard',{p_days:days});if(error){if(status)status.textContent='This account is not authorized.';await sb.auth.signOut();return}login?.classList.add('hidden');dashboard?.classList.remove('hidden');const vals=[data.totalEvents,data.searches,data.zeroResults,data.telegramClicks,data.marketEngagement];vals.forEach((v,i)=>{const e=document.getElementById(`k-${i}`);if(e)e.textContent=String(v)});const u=document.getElementById('updated');if(u)u.textContent=`Last ${data.days} days · ${new Date(data.generatedAt).toLocaleString()}`;list('top-searches',data.topSearches);list('zero-searches',data.zeroResultTerms,'No zero-result searches.');list('top-content',data.topContent);list('event-mix',data.eventMix)}
 document.getElementById('login-btn')?.addEventListener('click',async()=>{const email=document.getElementById('email')?.value?.trim();if(!email)return;if(status)status.textContent='Sending secure link…';const {error}=await sb.auth.signInWithOtp({email,options:{emailRedirectTo:location.origin+'/analytics/'}});if(status)status.textContent=error?error.message:'Check your email for the secure sign-in link.'});
 document.getElementById('logout')?.addEventListener('click',async()=>{await sb.auth.signOut();location.reload()});document.querySelectorAll('.range').forEach(b=>b.addEventListener('click',()=>{days=Number(b.dataset.days);load()}));sb.auth.onAuthStateChange(()=>load());load();
}
</script>
</BaseLayout>
