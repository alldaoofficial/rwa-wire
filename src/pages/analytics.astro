---
import BaseLayout from "@/layouts/BaseLayout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
---
<BaseLayout title="Growth Analytics — RWA Wire" description="Private RWA Wire growth analytics dashboard.">
<div id="analytics-app" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} class="wire-container py-10 sm:py-14">
<header class="border-b border-line pb-8"><p class="data-label text-wire">RWA Wire // Internal</p><h1 class="mt-2 font-serif text-4xl text-ink sm:text-5xl">Growth Analytics</h1><p class="mt-3 text-sm text-ink-muted">Private product signals from first-party interaction events.</p></header>
<section id="setup" class="hidden mt-10 border border-line bg-surface p-6"><p class="data-label text-wire">Setup required</p><p class="mt-3 text-sm text-ink-muted">The public Supabase connection variables are not configured for this build yet.</p></section>
<section id="login" class="mx-auto mt-14 max-w-lg border border-line bg-surface p-6 sm:p-8"><p class="data-label text-wire">Admin access</p><h2 class="mt-2 font-serif text-2xl text-ink">Sign in to the desk</h2><p class="mt-3 text-sm text-ink-muted">Enter the authorized admin email. Supabase will send a one-time secure sign-in link.</p><input id="email" type="email" autocomplete="email" placeholder="Admin email" class="mt-5 w-full border border-line bg-bg px-4 py-3 text-sm text-ink outline-none focus:border-wire"><button id="login-btn" type="button" class="mt-3 w-full bg-wire px-4 py-3 text-[11px] font-semibold uppercase tracking-[.1em] text-bg disabled:cursor-not-allowed disabled:opacity-50">Send secure link</button><p id="status" role="status" aria-live="polite" class="mt-3 text-xs text-ink-muted"></p></section>
<section id="dashboard" class="hidden mt-8"><div class="flex flex-wrap items-center justify-between gap-3"><p id="updated" class="font-mono text-[9px] uppercase tracking-[.08em] text-ink-muted"></p><div class="flex gap-1"><button data-days="1" class="range border border-line px-3 py-1.5 text-[9px] text-ink-muted">1D</button><button data-days="7" class="range border border-wire px-3 py-1.5 text-[9px] text-wire">7D</button><button data-days="30" class="range border border-line px-3 py-1.5 text-[9px] text-ink-muted">30D</button><button id="logout" class="ml-2 border border-line px-3 py-1.5 text-[9px] text-ink-muted">SIGN OUT</button></div></div><div class="mt-5 grid grid-cols-2 gap-px border border-line bg-line lg:grid-cols-5">{['Events','Searches','Zero results','Telegram','Market'].map((x,i)=><div class="bg-bg p-4"><p class="data-label">{x}</p><p id={`k-${i}`} class="mt-2 font-mono text-2xl text-ink">—</p></div>)}</div><div class="mt-5 grid gap-5 lg:grid-cols-2"><div class="border border-line p-5"><p class="data-label text-wire">Top searches</p><div id="top-searches" class="mt-4"></div></div><div class="border border-line p-5"><p class="data-label text-wire">Zero-result searches</p><div id="zero-searches" class="mt-4"></div></div><div class="border border-line p-5 lg:col-span-2"><p class="data-label text-wire">Most clicked content</p><div id="top-content" class="mt-4"></div></div><div class="border border-line p-5 lg:col-span-2"><p class="data-label text-wire">Event mix</p><div id="event-mix" class="mt-4"></div></div></div></section>
</div>
<script>
import { createClient } from '@supabase/supabase-js';
type MetricRow={label:string;value:number};
type DashboardData={days:number;totalEvents:number;searches:number;zeroResults:number;telegramClicks:number;marketEngagement:number;topSearches:MetricRow[];zeroResultTerms:MetricRow[];topContent:MetricRow[];eventMix:MetricRow[];generatedAt:string};
const app=document.getElementById('analytics-app') as HTMLElement|null;
const supabaseUrl=app?.dataset.supabaseUrl||'';
const supabaseKey=app?.dataset.supabaseKey||'';
const setup=document.getElementById('setup'),login=document.getElementById('login'),dashboard=document.getElementById('dashboard'),status=document.getElementById('status');
const loginBtn=document.getElementById('login-btn') as HTMLButtonElement|null;
const emailInput=document.getElementById('email') as HTMLInputElement|null;
const cooldownKey='rwa-analytics-login-cooldown-until';
let cooldownTimer:number|undefined;
const setStatus=(message:string)=>{if(status)status.textContent=message};
const setCooldown=(seconds:number,message?:string)=>{const until=Date.now()+seconds*1000;sessionStorage.setItem(cooldownKey,String(until));if(message)setStatus(message);renderCooldown()};
const renderCooldown=()=>{if(cooldownTimer)window.clearTimeout(cooldownTimer);const until=Number(sessionStorage.getItem(cooldownKey)||0);const remaining=Math.max(0,Math.ceil((until-Date.now())/1000));if(!loginBtn)return;if(remaining>0){loginBtn.disabled=true;loginBtn.textContent=`Try again in ${remaining}s`;cooldownTimer=window.setTimeout(renderCooldown,1000)}else{sessionStorage.removeItem(cooldownKey);loginBtn.disabled=false;loginBtn.textContent='Send secure link'}};
if(!supabaseUrl||!supabaseKey){setup?.classList.remove('hidden');login?.classList.add('hidden')}else{
 const sb=createClient(supabaseUrl,supabaseKey);let days=7;
 const esc=(s:unknown)=>String(s).replace(/[&<>"']/g,(c:string)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]??c));
 const list=(id:string,rows:MetricRow[]|undefined,empty='No data yet.')=>{const el=document.getElementById(id);if(el)el.innerHTML=rows?.length?rows.map((x:MetricRow,i:number)=>`<div class="flex gap-3 border-b border-line/70 py-2.5"><span class="w-5 font-mono text-[9px] text-ink-muted">${i+1}</span><span class="min-w-0 flex-1 truncate text-xs text-ink">${esc(x.label)}</span><span class="font-mono text-xs text-wire">${x.value}</span></div>`).join(''):`<p class="py-4 text-xs text-ink-muted">${empty}</p>`};
 async function load(){const {data:{session}}=await sb.auth.getSession();if(!session){login?.classList.remove('hidden');dashboard?.classList.add('hidden');return}const {data,error}=await sb.rpc('get_growth_dashboard',{p_days:days});if(error){setStatus('This account is not authorized.');await sb.auth.signOut();return}const d=data as DashboardData;login?.classList.add('hidden');dashboard?.classList.remove('hidden');const vals=[d.totalEvents,d.searches,d.zeroResults,d.telegramClicks,d.marketEngagement];vals.forEach((v:number,i:number)=>{const e=document.getElementById(`k-${i}`);if(e)e.textContent=String(v)});const u=document.getElementById('updated');if(u)u.textContent=`Last ${d.days} days · ${new Date(d.generatedAt).toLocaleString()}`;list('top-searches',d.topSearches);list('zero-searches',d.zeroResultTerms,'No zero-result searches.');list('top-content',d.topContent);list('event-mix',d.eventMix)}
 loginBtn?.addEventListener('click',async()=>{const email=emailInput?.value.trim();if(!email){setStatus('Enter the admin email first.');return}if(loginBtn.disabled)return;loginBtn.disabled=true;loginBtn.textContent='Sending…';setStatus('Requesting a secure sign-in link…');const {error}=await sb.auth.signInWithOtp({email,options:{emailRedirectTo:'https://therwawire.com/analytics/'}});if(error){const message=error.message.toLowerCase();if(message.includes('rate limit')||message.includes('too many')){setCooldown(60,'Too many email requests. Please wait before trying again.')}else{loginBtn.disabled=false;loginBtn.textContent='Send secure link';setStatus(error.message)}return}setStatus('Secure link sent. Check your email. You can request another link in 60 seconds.');setCooldown(60);});
 document.getElementById('logout')?.addEventListener('click',async()=>{await sb.auth.signOut();location.reload()});document.querySelectorAll<HTMLButtonElement>('.range').forEach(b=>b.addEventListener('click',()=>{days=Number(b.dataset.days||7);load()}));sb.auth.onAuthStateChange(()=>load());renderCooldown();load();
}
</script>
</BaseLayout>
