---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { institutions } from "@/data/institutions";
import { getCollection } from "astro:content";
import { sitePath } from "@/utils/paths";
const reports=(await getCollection("articles",({data})=>!data.draft&&data.type!=="EXPLAINER")).filter(a=>a.data.pubDate.valueOf()<=Date.now()).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const evidence=institutions.map(i=>{const re=new RegExp("(^|[^a-z0-9])"+i.name+"(?=$|[^a-z0-9])","i");const aliases=i.slug==="jpmorgan"?[/\\bjp\\s?morgan\\b/i]:[];const matches=reports.filter(a=>{const text=[a.data.title,a.data.description,...a.data.tags].join(" ");return re.test(text)||aliases.some(alias=>alias.test(text));});return {...i,matches,latest:matches[0]?.data.pubDate??null};}).sort((a,b)=>b.matches.length-a.matches.length);
const total=evidence.reduce((n,i)=>n+i.matches.length,0);
const max=Math.max(1,...evidence.map(i=>i.matches.length));
---
<BaseLayout title="Institution Intelligence" description="Structured intelligence on institutions participating in tokenized finance and real-world asset markets.">
  <div class="wire-container py-10 sm:py-14">
    <Breadcrumbs items={[{label:"Institutions",href:"/institutions/"}]} />
    <header class="mt-4 border-b border-line pb-10">
      <p class="data-label text-wire">RWA Wire // Institutions</p>
      <h1 class="mt-3 max-w-4xl font-serif text-4xl font-medium leading-tight text-ink sm:text-5xl">Institutions shaping the tokenized economy.</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-muted">See which banks, asset managers and market operators are active in tokenized finance — and follow their connections without needing to decode the whole market first.</p><div class="mt-6 grid max-w-3xl gap-2 sm:grid-cols-3"><div class="border border-line bg-surface/60 p-3"><p class="font-mono text-[10px] text-wire">01</p><p class="mt-1 text-xs text-ink">Choose an institution</p></div><div class="border border-line bg-surface/60 p-3"><p class="font-mono text-[10px] text-wire">02</p><p class="mt-1 text-xs text-ink">See what it is connected to</p></div><div class="border border-line bg-surface/60 p-3"><p class="font-mono text-[10px] text-wire">03</p><p class="mt-1 text-xs text-ink">Open the underlying coverage</p></div></div>
    </header>
    <section class="mt-8 rounded-xl border border-line bg-surface p-5 sm:p-7" data-reveal aria-labelledby="coverage-title">
      <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="data-label text-wire">Institution intelligence / Coverage monitor</p><h2 id="coverage-title" class="mt-2 font-serif text-2xl text-ink">Who's appearing in verified coverage?</h2></div><span class="font-mono text-xs text-ink-muted">{total} institution–article matches · {institutions.length} tracked entities</span></div>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-ink-muted">A transparent view of how often tracked institutions are mentioned in published RWA Wire reporting. These are editorial mentions, not independently verified partnerships, capital flows, market share or adoption rankings. One article can mention several institutions.</p>
      <div class="mt-5 grid gap-3 sm:grid-cols-[1fr_220px]"><label class="text-xs text-ink-muted">Search institutions<input id="institution-search" type="search" placeholder="Search institution or focus..." class="mt-1 w-full rounded-lg border border-line bg-bg px-3 py-2.5 text-sm text-ink placeholder:text-ink-muted" /></label><label class="text-xs text-ink-muted">Publication window<select id="institution-window" class="mt-1 w-full rounded-lg border border-line bg-bg px-3 py-2.5 text-sm text-ink"><option value="all">All published dates</option><option value="30">Last 30 days</option><option value="90">Last 90 days</option></select></label></div>
      <p id="institution-count" class="mt-4 text-xs text-ink-muted" aria-live="polite">Showing {evidence.length} institutions</p>
      <div class="mt-3 grid gap-3 lg:grid-cols-2">{evidence.map(i=><article data-institution data-search={[i.name,i.type,...i.focus].join(" ").toLowerCase()} class="rounded-xl border border-line bg-bg p-4 sm:p-5">
        <div class="flex items-start justify-between gap-3"><div><p class="data-label text-wire">{i.type}</p><h3 class="mt-1 text-lg font-semibold text-ink"><a class="hover:text-wire" href={sitePath(`/institutions/intelligence/${i.slug}/`)}>{i.name}</a></h3></div><div class="text-right"><span data-mention-count class="font-mono text-2xl text-ink">{i.matches.length}</span><p class="text-[10px] text-ink-muted">article mentions</p></div></div>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-surface"><div data-mention-bar class="h-full rounded-full bg-wire" style={`width:${i.matches.length/max*100}%`}></div></div>
        <p class="mt-3 text-xs text-ink-muted">Latest matching report: {i.latest?i.latest.toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric",timeZone:"UTC"}):"No published match"}</p>
        <div class="mt-3 space-y-2" data-mention-list>{i.matches.slice(0,20).map(a=><a data-mention data-date={a.data.pubDate.toISOString()} href={sitePath(`/${a.data.category}/${a.slug}/`)} class="block border-t border-line pt-2 text-xs leading-5 text-ink-muted hover:text-wire"><span class="font-mono text-[10px]">{a.data.pubDate.toLocaleDateString("en-GB",{day:"numeric",month:"short",timeZone:"UTC"})}</span> · {a.data.title}</a>)}</div>
        <p data-mention-empty class="mt-3 hidden text-xs text-ink-muted">No matching published articles in this window.</p>
        <a href={sitePath(`/institutions/intelligence/${i.slug}/`)} class="mt-4 inline-block text-xs font-semibold text-wire">Open institution profile ↗</a>
      </article>)}</div>
      <p class="mt-4 text-xs leading-5 text-ink-muted">Matching uses institution names in article titles, descriptions and tags; full article bodies are not searched. Each card displays at most 20 latest matching reports. Counts reflect this publication's coverage, not all market activity.</p>
    </section>
    <script>
      const cards=Array.from(document.querySelectorAll<HTMLElement>("[data-institution]"));
      const search=document.querySelector<HTMLInputElement>("#institution-search");
      const windowSelect=document.querySelector<HTMLSelectElement>("#institution-window");
      const summary=document.querySelector<HTMLElement>("#institution-count");
      function applyInstitutionFilters(){
        const q=search?.value.toLowerCase().trim()??"";
        const days=Number(windowSelect?.value??0);
        const cutoff=days?Date.now()-days*86400000:0;
        let shown=0;let max=1;
        const counts=cards.map(card=>{
          const mentions=Array.from(card.querySelectorAll<HTMLElement>("[data-mention]"));
          const count=mentions.filter(m=>!cutoff||new Date(m.dataset.date??"").valueOf()>=cutoff).length;
          max=Math.max(max,count);
          return count;
        });
        cards.forEach((card,index)=>{
          const matches=(card.dataset.search??"").includes(q);
          card.hidden=!matches;
          if(matches)shown++;
          const count=counts[index];
          const countLabel=card.querySelector<HTMLElement>("[data-mention-count]");
          if(countLabel)countLabel.textContent=String(count);
          const bar=card.querySelector<HTMLElement>("[data-mention-bar]");
          if(bar)bar.style.width=`${count/max*100}%`;
          card.querySelectorAll<HTMLElement>("[data-mention]").forEach(m=>m.hidden=!!cutoff&&new Date(m.dataset.date??"").valueOf()<cutoff);
          const empty=card.querySelector<HTMLElement>("[data-mention-empty]");
          if(empty)empty.hidden=count!==0;
        });
        if(summary)summary.textContent=`Showing ${shown} institutions · article mentions in selected window (up to 20 displayed per institution)`;
      }
      search?.addEventListener("input",applyInstitutionFilters);
      windowSelect?.addEventListener("change",applyInstitutionFilters);
      applyInstitutionFilters();
    </script>
    <section class="mt-8"><div class="mb-4"><p class="data-label text-wire">Step 1 // Choose</p><h2 class="mt-2 font-serif text-2xl text-ink">Institution directory</h2></div><div class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">
      {institutions.map(i => <a href={`/institutions/intelligence/${i.slug}/`} class="group bg-bg p-6 hover:bg-surface">
        <div class="flex items-center justify-between gap-3"><p class="data-label text-wire">{i.type}</p><span class="font-mono text-[10px] text-ink-muted">{i.status}</span></div>
        <h2 class="mt-4 font-serif text-2xl text-ink group-hover:text-wire">{i.name}</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{i.role}</p>
        <div class="mt-5 flex flex-wrap gap-1.5">{i.focus.map(x=><span class="border border-line px-2 py-1 text-[9px] uppercase tracking-[.08em] text-ink-muted">{x}</span>)}</div>
      </a>)}
    </div></section>
  </div>
</BaseLayout>
