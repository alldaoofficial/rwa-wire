---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
const enabled = import.meta.env.PUBLIC_NEWSLETTER_ENABLED === 'true' && Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
---
<BaseLayout title="Newsletter — RWA Wire" description="Subscribe, confirm or manage your RWA Wire newsletter subscription.">
  <script slot="head" is:inline>
    (() => {
      window.rwaNewsletterFragment = location.hash;
      if (location.hash) history.replaceState(null, '', location.pathname);
    })();
  </script>
  <div class="wire-container max-w-content py-12">
    <h1 class="font-serif text-3xl text-ink">RWA Wire Newsletter</h1>
    <div id="newsletter-manage" hidden class="mt-6 border border-line bg-surface p-6">
      <p id="newsletter-message" role="status" aria-live="polite" class="text-sm text-ink-muted"></p>
      <button id="newsletter-action" type="button" hidden class="mt-4 bg-wire px-5 py-3 text-sm font-semibold text-bg">Continue</button>
    </div>
    <div id="newsletter-signup" class="mt-6">
      {enabled ? <NewsletterSignup placement="newsletter-page" /> : <p class="text-sm text-ink-muted">Email subscriptions are not open yet. Follow our latest coverage on <a href="https://t.me/RWAWireHQ" class="text-wire underline">Telegram</a>.</p>}
    </div>
  </div>
  <script is:inline>
    // Remove capability tokens before analytics or other page scripts can read the URL.
    (() => {
      const fragment = window.rwaNewsletterFragment || '';
      delete window.rwaNewsletterFragment;
      const match = /^#(confirm|unsubscribe)=([a-f0-9]{64})$/.exec(fragment);
      const hadHash = Boolean(fragment);
      if (!hadHash) return;
      document.getElementById('newsletter-signup').hidden=true;
      const panel=document.getElementById('newsletter-manage'), message=document.getElementById('newsletter-message'), button=document.getElementById('newsletter-action');
      panel.hidden=false;
      if (!match) {message.textContent='This link is invalid. Please request a new confirmation email.'; return;}
      const [,action,token]=match;
      message.textContent=action==='confirm'?'Confirm that you want to receive the RWA Wire newsletter.':'Click below to unsubscribe from the RWA Wire newsletter.';
      button.textContent=action==='confirm'?'Confirm subscription':'Unsubscribe'; button.hidden=false;
      button.addEventListener('click', async()=>{
        button.disabled=true;
        try {
          const response=await fetch('https://dqeakkrsbgxnexucuyld.supabase.co/functions/v1/newsletter',{method:'POST',headers:{'content-type':'application/json'},credentials:'omit',signal:AbortSignal.timeout(15000),body:JSON.stringify({action,token})});
          const data=await response.json();
          if (!response.ok) {message.textContent=data.code==='invalid_link'?'This link has expired or has already been used.':'The service is temporarily unavailable. Please try again.'; button.disabled=false; return;}
          message.textContent=action==='confirm'?'Subscription confirmed. You can unsubscribe using the link in any newsletter.':'You have been unsubscribed.';
          button.hidden=true;
          window.rwaAnalytics?.track(action==='confirm'?'newsletter_confirmed':'newsletter_unsubscribed','newsletter',{placement:'newsletter-page'});
        } catch {message.textContent='The service is temporarily unavailable. Please try again.'; button.disabled=false;}
      });
    })();
  </script>
</BaseLayout>
