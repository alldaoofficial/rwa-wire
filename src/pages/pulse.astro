---
import BaseLayout from "@/layouts/BaseLayout.astro";
import markets from "../../public/data/markets.json";
const priced=Object.values(markets.assets??{}).filter(a=>typeof a.usd==="number"&&typeof a.usd_24h_change==="number");
const advancing=priced.filter(a=>(a.usd_24h_change??0)>0).length;
const avg=priced.length?priced.reduce((sum,a)=>sum+(a.usd_24h_change??0),0)/priced.length:0;
const updated=new Date(markets.fetchedAt).toLocaleString("en-GB",{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit",timeZone:"UTC"})+" UTC";
import { getCollection } from "astro:content";
import { sitePath } from "../utils/paths";
const recent = (await getCollection("articles", ({ data }) => !data.draft && ["news","markets","rwa","tokenization","institutions"].includes(data.category)))
  .sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,5);
---
<BaseLayout title="RWA Pulse | Daily Tokenized Finance Market Snapshot" description="Your daily RWA market snapshot: tracked token prices, 24-hour performance, market breadth and the latest source-led tokenization coverage.">
  <section class="wire-container py-14 sm:py-20">
    <p class="wire-kicker">Daily intelligence / RWA Pulse</p>
    <h1 data-reveal class="wire-display mt-5">The market in 60 seconds.</h1>
    <p data-reveal class="wire-lede mt-6">A repeatable daily check-in: the latest available market snapshot, followed by developments worth reading. Market data reflects a tracked token basket, not the value of all tokenized real-world assets.</p>
    <div data-reveal class="mt-8 flex flex-wrap gap-3"><a href="#pulse-market" class="wire-action">Market snapshot ↓</a><a href="#pulse-news" class="wire-action">Latest coverage ↓</a><a href={sitePath("/radar/")} class="wire-action wire-action-primary">Explore RWA Radar →</a></div>
  </section>
  <section id="pulse-market" class="wire-container pb-10"><div class="grid gap-4 sm:grid-cols-3" data-reveal><div class="wire-panel p-6"><p class="wire-kicker">Tracked 24h average</p><p class:list={["mt-3 font-mono text-3xl font-semibold",avg>=0?"text-wire":"text-rose-400"]}>{avg>=0?"+":""}{avg.toFixed(2)}%</p><p class="mt-2 text-xs text-ink-muted">Equal-weighted change of available tokens</p></div><div class="wire-panel p-6"><p class="wire-kicker">Market breadth</p><p class="mt-3 font-mono text-3xl font-semibold text-ink">{advancing} / {priced.length}</p><p class="mt-2 text-xs text-ink-muted">Priced tokens advancing</p></div><div class="wire-panel p-6"><p class="wire-kicker">Snapshot freshness</p><p class="mt-3 font-mono text-base font-semibold text-ink">{updated}</p><p class="mt-2 text-xs text-ink-muted">Source: {markets.source} · cached, not live</p></div></div><div class="mt-5 wire-panel flex flex-wrap items-center justify-between gap-4 p-6" data-reveal><div><h2 class="text-xl font-semibold text-ink">Want the full token screener and charts?</h2><p class="mt-2 max-w-xl text-sm text-ink-muted">All {priced.length} priced assets share the same cached dataset as RWA Intelligence. Explore sectors, filter projects and star your favorites there.</p></div><a class="wire-action wire-action-primary" href={sitePath("/intelligence/")}>Open Intelligence ↗</a></div></section>
  <section class="wire-container py-8 sm:py-12" data-reveal><div class="wire-panel flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-7"><div><p class="wire-kicker">Go deeper / Historical market context</p><h2 class="mt-2 text-xl font-semibold text-ink sm:text-2xl">A daily move is only one data point.</h2><p class="mt-2 max-w-2xl text-sm leading-6 text-ink-muted">Explore recorded price observations, switch between 24 hours, 7 days and 30 days, and compare the snapshot with its available history. Charts only appear when actual observations exist.</p></div><a href={sitePath("/intelligence/#market-history")} class="wire-action shrink-0">Open history chart ↗</a></div></section>
  <section id="pulse-news" class="wire-container py-12 sm:py-16">
    <div class="flex items-end justify-between gap-4 border-b border-line pb-4"><div><p class="eyebrow text-wire">Editorial desk</p><h2 class="mt-2 font-serif text-2xl text-ink">Latest verified coverage</h2></div><a class="text-xs text-wire" href={sitePath("/news/")}>All news →</a></div>
    <div data-reveal class="divide-y divide-line">
      {recent.map((entry) => <a href={sitePath(`/${entry.data.category}/${entry.slug}/`)} class="block rounded-xl px-4 py-6 transition hover:bg-surface/60"><p class="font-mono text-[10px] uppercase tracking-wider text-ink-muted">{entry.data.category} · {entry.data.pubDate.toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric",timeZone:"UTC"})}</p><h3 class="mt-2 font-serif text-xl leading-snug text-ink sm:text-2xl">{entry.data.title}</h3><p class="mt-2 max-w-3xl text-sm leading-6 text-ink-muted">{entry.data.description}</p></a>)}
    </div>
  </section>
</BaseLayout>
