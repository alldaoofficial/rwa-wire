---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { sitePath } from "../utils/paths";
const articles = (await getCollection("articles", ({ data }) => !data.draft && data.type !== "EXPLAINER"))
  .sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [
  { id:"institutions", name:"Institutional adoption", terms:["bank","institution","asset manager","partnership","custody","brokerage","institutional"] },
  { id:"funds", name:"Tokenized funds", terms:["fund","treasur","etf","money market","bond","credit","yield"] },
  { id:"regulation", name:"Regulation", terms:["regulat","sec","compliance","license","legislation","policy","micar","mica"] },
  { id:"infrastructure", name:"Infrastructure & launches", terms:["launch","network","blockchain","platform","settlement","tokeniz","infrastructure"] },
];
const signals = categories.map((group) => ({
  ...group,
  entries: articles.filter((entry) => {
    const haystack = [entry.data.title,entry.data.description,...entry.data.tags].join(" ").toLowerCase();
    return group.terms.some((term) => haystack.includes(term));
  }).slice(0,5),
}));
const dateLabel = (date: Date) => date.toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric",timeZone:"UTC"});
---
<BaseLayout title="RWA Radar | Institutional Tokenization Developments" description="Track reported institutional adoption, tokenized funds, regulatory developments and infrastructure launches with links to RWA Wire coverage.">
  <section class="border-b border-line"><div class="wire-container py-10 sm:py-14">
    <p class="eyebrow text-wire">Intelligence desk // RWA Radar</p>
    <h1 class="mt-3 font-serif text-4xl text-ink sm:text-5xl">Spot the developments that matter.</h1>
    <p class="mt-4 max-w-3xl text-sm leading-6 text-ink-muted">A topic-organized view of published RWA Wire reporting. Stories are matched by keywords and may appear in multiple categories. This is an editorial discovery tool, not a real-time alert feed or a ranking of investment opportunities.</p>
    <div class="mt-6 flex flex-wrap gap-2">{signals.map((group) => <a href={`#${group.id}`} class="border border-line px-3 py-2 text-xs text-ink-muted hover:border-wire hover:text-wire">{group.name} ↓</a>)}</div>
  </div></section>
  <div class="wire-container py-10 sm:py-14">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{signals.map((group) => <a href={`#${group.id}`} class="border border-line bg-surface p-5 hover:border-wire/60"><p class="data-label text-wire">{group.name}</p><p class="mt-3 font-mono text-3xl text-ink">{group.entries.length}</p><p class="mt-1 text-xs text-ink-muted">Recent matching stories</p></a>)}</div>
    <div class="mt-12 space-y-12">{signals.map((group) => <section id={group.id} class="scroll-mt-28"><div class="flex items-end justify-between gap-4 border-b border-line pb-3"><h2 class="font-serif text-2xl text-ink">{group.name}</h2><span class="font-mono text-[10px] text-ink-muted">{group.entries.length} recent matches</span></div>{group.entries.length ? <div class="divide-y divide-line">{group.entries.map((entry) => <a href={sitePath(`/${entry.data.category}/${entry.slug}/`)} class="block py-5 hover:bg-surface/50"><p class="font-mono text-[10px] uppercase tracking-wider text-ink-muted">{dateLabel(entry.data.pubDate)} · {entry.data.category}</p><h3 class="mt-2 font-serif text-lg text-ink">{entry.data.title}</h3><p class="mt-2 max-w-3xl text-sm leading-6 text-ink-muted">{entry.data.description}</p></a>)}</div> : <p class="py-5 text-sm text-ink-muted">No matching published stories yet. Check back as new reporting arrives.</p>}</section>)}</div>
    <div class="mt-12 border border-line bg-surface p-6"><p class="data-label text-wire">Make it a daily habit</p><h2 class="mt-2 font-serif text-2xl text-ink">Start with the market. Then follow the signals.</h2><a href={sitePath("/pulse/")} class="mt-4 inline-block text-sm font-semibold text-wire">Open RWA Pulse →</a></div>
  </div>
</BaseLayout>
