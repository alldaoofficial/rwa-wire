---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
---

<BaseLayout
  title="Privacy Policy"
  description="RWA Wire's privacy policy covering what data we collect and how it's used."
>
  <div class="wire-container max-w-content py-10 sm:py-14">
    <Breadcrumbs items={[{ label: "Privacy", href: "/privacy/" }]} />
    <h1 class="mt-4 font-serif text-3xl font-medium text-ink sm:text-4xl">Privacy Policy</h1>
    <p class="mt-3 text-sm text-ink-muted">Last updated: placeholder — replace before launch.</p>

    <div class="prose prose-invert prose-wire mt-8 max-w-none">
      <p>
        <strong>This is placeholder content.</strong> Replace it with a
        privacy policy reviewed by qualified counsel before launch. It
        should cover, at minimum:
      </p>
      <ul>
        <li>What data RWA Wire collects (e.g. analytics, newsletter or Telegram sign-ups)</li>
        <li>How that data is used and with whom it may be shared</li>
        <li>Cookie and tracking technology usage</li>
        <li>User rights regarding their data (access, deletion, opt-out) under applicable law</li>
        <li>How to contact RWA Wire with privacy questions</li>
      </ul>
      <p>
        Because this site is designed as a static site with no backend or
        database by default, it does not collect personal data directly
        unless analytics or third-party embeds (e.g. Telegram, a newsletter
        provider) are added later — update this policy if and when those are
        introduced.
      </p>
    </div>
  </div>
</BaseLayout>
