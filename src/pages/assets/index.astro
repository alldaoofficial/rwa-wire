---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { assets } from "@/data/assets";
---
<BaseLayout title="Asset Intelligence" description="Structured profiles of tokenized funds, securities and real-world assets tracked by RWA Wire.">
<div class="wire-container py-10 sm:py-14">
  <Breadcrumbs items={[{label:"Assets",href:"/assets/"}]} />
  <header class="relative mt-5 overflow-hidden border-b border-line pb-10">
    <div class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-wire/5 blur-3xl"></div>
    <p class="data-label text-wire">RWA Wire // Asset Intelligence</p>
    <h1 class="mt-3 max-w-4xl font-serif text-4xl text-ink sm:text-5xl">Follow the assets moving onchain.</h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-muted">Start with the financial product itself. Then see who manages it, who tokenizes it, which networks it uses and where it appears in the wider market.</p>
  </header>
  <section class="mt-8">
    <div class="mb-4"><p class="data-label text-wire">01 // Choose an asset</p><h2 class="mt-2 font-serif text-2xl text-ink">Tracked assets</h2></div>
    <div class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">{assets.map(a=><a href={`/assets/${a.slug}/`} class="group bg-bg p-6 hover:bg-surface"><div class="flex items-center justify-between"><p class="data-label text-wire">{a.assetClass}</p><span class="font-mono text-[10px] text-ink-muted">{a.status}</span></div><h2 class="mt-4 font-serif text-3xl text-ink group-hover:text-wire">{a.name}</h2><p class="mt-2 text-xs text-ink-muted">{a.fullName}</p><p class="mt-4 text-sm leading-relaxed text-ink-muted">{a.summary}</p><p class="mt-5 text-[10px] uppercase tracking-[.1em] text-wire">Open asset intelligence →</p></a>)}</div>
  </section>
</div>
</BaseLayout>
