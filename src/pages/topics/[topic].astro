---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { sitePath } from "@/utils/paths";

export function getStaticPaths(){
  const topics = [
    { slug:"real-world-assets", title:"Real-World Assets", description:"The foundations of RWA markets: asset classes, legal structures and the infrastructure connecting offchain value to programmable networks.", terms:["rwa","real-world assets","real world assets"], primary:"what-are-real-world-assets" },
    { slug:"tokenized-treasuries", title:"Tokenized Treasuries", description:"Research, market structure and infrastructure for blockchain-based exposure to U.S. government securities and Treasury-backed funds.", terms:["treasur","government securities"], primary:"tokenized-treasuries-explained" },
    { slug:"tokenized-securities", title:"Tokenized Securities", description:"Equities, bonds, funds and regulated securities moving onto blockchain rails.", terms:["tokenized securities","tokenized stocks","equities","bonds","funds"], primary:"tokenized-stocks-explained" },
    { slug:"private-credit", title:"Private Credit", description:"Onchain lending, private-credit funds and the infrastructure connecting borrowers, asset managers and digital capital markets.", terms:["private credit","credit infrastructure","lending"], primary:"maple-finance-explained" },
    { slug:"institutional-tokenization", title:"Institutional Tokenization", description:"Banks, asset managers and market infrastructure building programmable issuance, deposits, settlement and distribution.", terms:["institution","banks","asset managers","settlement","deposits"], primary:"the-companies-building-tokenized-finance" },
  ];
  return topics.map(topic=>({params:{topic:topic.slug},props:{topic}}));
}