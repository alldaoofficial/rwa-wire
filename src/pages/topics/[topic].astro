---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { sitePath } from "@/utils/paths";

const topicDefs = [
  { slug:"real-world-assets", title:"Real-World Assets", description:"The foundations of RWA markets: asset classes, legal structures and the infrastructure connecting offchain value to programmable networks.", terms:["rwa","real-world assets","real world assets"], primary:"what-are-real-world-assets" },
  { slug:"tokenized-treasuries", title:"Tokenized Treasuries", description:"Research, market structure and infrastructure for blockchain-based exposure to U.S. government securities and Treasury-backed funds.", terms:["treasur","government securities"], primary:"tokenized-treasuries-explained" },
  { slug:"tokenized-securities", title:"Tokenized Securities", description:"Equities, bonds, funds and regulated securities moving onto blockchain rails.", terms:["tokenized securities","tokenized stocks","equities","bonds","funds"], primary:"tokenized-stocks-explained" },
  { slug:"private-credit", title:"Private Credit", description:"Onchain lending, private-credit funds and the infrastructure connecting borrowers, asset managers and digital capital markets.", terms:["private credit","credit infrastructure","lending"], primary:"maple-finance-explained" },
  { slug:"institutional-tokenization", title:"Institutional Tokenization", description:"Banks, asset managers and market infrastructure building programmable issuance, deposits, settlement and distribution.", terms:["institution","banks","asset managers","settlement","deposits"], primary:"the-companies-building-tokenized-finance" },
];
export function getStaticPaths(){return topicDefs.map(topic=>({params:{topic:topic.slug},props:{topic}}));}
const { topic } = Astro.props;
const all = await getCollection("articles", ({data}) => !data.draft);
const hay=(a:any)=>[a.data.title,a.data.description,...a.data.tags,a.data.projectMeta?.sector,a.data.projectMeta?.role,a.data.projectMeta?.assetExposure,...(a.data.projectMeta?.products??[])].filter(Boolean).join(" ").toLowerCase();
const matches=all.map(a=>({a,score:topic.terms.reduce((n,t)=>n+(hay(a).includes(t)?1:0),0)+(a.slug===topic.primary?5:0)})).filter(x=>x.score>0).sort((x,y)=>y.score-x.score||y.a.data.pubDate.valueOf()-x.a.data.pubDate.valueOf());
const projects=matches.filter(x=>x.a.data.type==="PROJECT").slice(0,6);
const editorial=matches.filter(x=>x.a.data.type!=="PROJECT").slice(0,10);
---
<BaseLayout title={topic.title} description={topic.description}>
<div class="wire-container py-10 sm:py-14">
  <Breadcrumbs items={[{label:"Topics",href:"/topics/"},{label:topic.title,href:`/topics/${topic.slug}/`}]} />
  <header class="mt-5 border-b border-line pb-10"><p class="data-label text-wire">RWA Wire // Topic Intelligence</p><h1 class="mt-3 max-w-4xl font-serif text-4xl text-ink sm:text-5xl">{topic.title}</h1><p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-muted">{topic.description}</p></header>
  {editorial.length>0&&<section class="mt-10"><p class="data-label text-wire">Research & coverage</p><div class="mt-4 grid gap-px bg-line md:grid-cols-2">{editorial.map(({a},i)=><a href={sitePath(`/${a.data.category}/${a.slug}/`)} class:list={["group bg-bg p-6 hover:bg-surface",i===0&&"md:col-span-2"]}><p class="data-label">{a.data.category} // {a.data.type}</p><h2 class:list={["mt-3 font-serif leading-tight text-ink group-hover:text-wire",i===0?"text-3xl":"text-xl"]}>{a.data.title}</h2><p class="mt-3 text-sm leading-relaxed text-ink-muted">{a.data.description}</p></a>)}</div></section>}
  {projects.length>0&&<section class="mt-12 border-t border-line pt-8"><div class="flex items-end justify-between"><div><p class="data-label text-wire">Infrastructure layer</p><h2 class="mt-2 font-serif text-2xl text-ink">Projects connected to {topic.title}</h2></div><a href="/projects/" class="text-[10px] uppercase tracking-[.1em] text-wire">Directory →</a></div><div class="mt-5 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">{projects.map(({a})=><a href={sitePath(`/projects/${a.slug}/`)} class="group bg-bg p-5 hover:bg-surface"><p class="data-label">{a.data.projectMeta?.sector}</p><h3 class="mt-2 font-serif text-xl text-ink group-hover:text-wire">{a.data.title.replace(/ Explained$/,"")}</h3><p class="mt-2 text-xs text-ink-muted">{a.data.projectMeta?.role}</p></a>)}</div></section>}
</div>
</BaseLayout>