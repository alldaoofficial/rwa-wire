---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { TELEGRAM_URL } from "@/config/site";
---
<BaseLayout title="Contact" description="Contact RWA Wire for news tips, corrections, partnerships and general enquiries.">
  <div class="wire-container max-w-content py-10 sm:py-14">
    <Breadcrumbs items={[{ label: "Contact", href: "/contact/" }]} />
    <h1 class="mt-4 font-serif text-3xl font-medium text-ink sm:text-4xl">Contact</h1>
    <div class="prose prose-invert prose-wire mt-8 max-w-none">
      <p>For editorial tips, corrections, partnership enquiries or general feedback, contact RWA Wire through our official Telegram channel.</p>
      <p><a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer">RWA Wire on Telegram</a></p>
      <p>Please do not send private keys, seed phrases, passwords or other sensitive account information.</p>
    </div>
  </div>
</BaseLayout>
