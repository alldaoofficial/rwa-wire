---
import {getCollection} from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {localizedPath} from "@/i18n/routes";
import copy from "@/i18n/copy.json";
export function getStaticPaths(){return ["de","es","fr"].map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as "de"|"es"|"fr"; const c=copy[lang];
const articles=(await getCollection("articles",({data})=>!data.draft && data.type!=="EXPLAINER" && ["news","rwa","tokenization","institutions","markets"].includes(data.category))).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,4);
---
<BaseLayout title="RWA Wire" description={c.intro}><div class="wire-container py-12 sm:py-16">
  <p class="eyebrow text-wire">RWA Wire // {c.tagline}</p><h1 class="mt-5 max-w-4xl font-serif text-4xl leading-tight text-ink sm:text-6xl">{c.hero}</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-ink-muted">{c.intro}</p>
  <section class="mt-10 grid gap-4 md:grid-cols-3">{[{path:"/learn/rwa-crypto-explained/",title:c.basics,text:c.learnIntro},{path:"/newsletter/",title:c.newsletter,text:c.newsletterNote},{path:"/bitunix/",title:c.guide,text:c.guideIntro}].map(card=><a href={localizedPath(card.path,lang)} class="border border-line bg-surface p-6 hover:border-wire"><h2 class="font-serif text-2xl text-ink">{card.title} →</h2><p class="mt-3 text-sm leading-6 text-ink-muted">{card.text}</p></a>)}</section>
  <section class="mt-14"><h2 class="font-serif text-3xl text-ink">{c.newsTitle}</h2><p class="mt-3 text-sm text-ink-muted">{c.newsNote}</p><div class="mt-6 grid gap-4 sm:grid-cols-2">{articles.map(article=><a href={`/${article.data.category}/${article.slug}/`} lang="en" class="border border-line p-5 hover:border-wire"><p class="data-label text-wire">{c.english} · {article.data.pubDate.toLocaleDateString(lang,{year:"numeric",month:"short",day:"numeric",timeZone:"UTC"})}</p><h3 class="mt-3 font-serif text-xl text-ink">{article.data.title}</h3><p class="mt-3 text-sm leading-6 text-ink-muted">{article.data.description}</p></a>)}</div><a href="/news/" lang="en" class="mt-6 inline-block text-wire">{c.allNews} →</a></section>
</div></BaseLayout>
