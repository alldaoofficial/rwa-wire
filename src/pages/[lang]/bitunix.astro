---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {AFFILIATE_URL} from "@/config/site";
import guides from "@/i18n/guides.json";
import copy from "@/i18n/copy.json";
export function getStaticPaths(){return ["de","es","fr"].map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as "de"|"es"|"fr"; const g=guides[lang]; const c=copy[lang];
---
<BaseLayout title={g.bitunixTitle} description={c.guideIntro}><article class="wire-container py-12 sm:py-16"><div class="mx-auto max-w-3xl"><p class="eyebrow text-wire">{c.partner}</p><h1 class="mt-4 font-serif text-4xl leading-tight text-ink sm:text-5xl">{g.bitunixTitle}</h1><p class="mt-6 text-lg leading-8 text-ink-muted">{c.guideIntro}</p><div class="mt-7 border border-wire/40 bg-wire/[.04] p-5"><p class="text-sm leading-7 text-ink-muted">{c.affiliate}</p><a href="/affiliate-disclosure/" lang="en" class="mt-3 inline-block text-sm text-wire underline">{c.disclosure}</a></div>{g.bitunixSections.map(([heading,...paragraphs])=><section class="mt-10"><h2 class="font-serif text-2xl text-ink">{heading}</h2>{paragraphs.map(text=><p class="mt-4 leading-8 text-ink-muted">{text}</p>)}</section>)}<a href={AFFILIATE_URL} rel="noopener noreferrer sponsored" target="_blank" data-affiliate-placement={`bitunix-guide-${lang}`} class="mt-8 inline-flex bg-wire px-6 py-3 font-semibold text-bg">{c.open} →</a><div class="mt-10 border-t border-line pt-6"><a href="/bitunix/" lang="en" class="text-wire">English original →</a></div></div></article></BaseLayout>
