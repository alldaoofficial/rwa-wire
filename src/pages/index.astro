---
import { sitePath } from "../utils/paths";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FeaturedArticle from "@/components/FeaturedArticle.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import TelegramCTA from "@/components/TelegramCTA.astro";
import MarketDashboard from "@/components/MarketDashboard.astro";

const allArticles = (await getCollection("articles", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const editorialArticles = allArticles.filter((a) => ["news", "rwa", "tokenization", "institutions", "markets"].includes(a.data.category) && a.data.type !== "EXPLAINER");
const [featured, ...editorialRest] = editorialArticles;
const latest = editorialRest.slice(0, 4);
const learnArticles = allArticles.filter((a) => a.data.category === "learn").slice(0, 3);
const projectArticles = allArticles.filter((a) => a.data.category === "projects").slice(0, 3);
---
<BaseLayout title="RWA Wire — The intelligence layer for the tokenized economy" description="News, research and explainers on real-world assets, tokenization and the infrastructure transforming global finance.">
  <section class="relative overflow-hidden border-b border-line"><div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_10%,rgba(46,212,122,.10),transparent_34%),linear-gradient(180deg,rgba(17,21,26,.35),transparent_75%)]"></div><div class="wire-container relative py-10 sm:py-12"><div class="grid gap-7 lg:grid-cols-[1fr_340px] lg:items-end"><div><p class="eyebrow text-wire">RWA Wire // Tokenized finance, decoded</p><h1 class="mt-3 max-w-4xl font-serif text-4xl font-medium leading-[.98] tracking-[-.025em] text-ink sm:text-5xl lg:text-[56px]">Follow what matters as traditional finance moves <span class="text-ink-muted">onchain.</span></h1><p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-ink-muted">Institutional moves, market developments and the infrastructure behind real-world asset tokenization — without the noise.</p></div><div class="grid grid-cols-2 gap-px border border-line bg-line"><a href="#market" class="group bg-bg p-4 hover:bg-surface"><span class="font-mono text-[9px] text-wire">01 // MARKET</span><p class="mt-1.5 text-sm font-medium text-ink">See the market →</p></a><a href="#latest" class="group bg-bg p-4 hover:bg-surface"><span class="font-mono text-[9px] text-wire">02 // LATEST</span><p class="mt-1.5 text-sm font-medium text-ink">What changed →</p></a><a href="/learn/" class="group bg-bg p-4 hover:bg-surface"><span class="font-mono text-[9px] text-wire">03 // LEARN</span><p class="mt-1.5 text-sm font-medium text-ink">Start with RWA →</p></a><a href="/map/" class="group bg-bg p-4 hover:bg-surface"><span class="font-mono text-[9px] text-wire">04 // MAP</span><p class="mt-1.5 text-sm font-medium text-ink">Explore the ecosystem →</p></a></div></div></div></section>
  <div id="market"><MarketDashboard /></div>
  {featured && <section id="latest" class="wire-container py-12 sm:py-16"><div class="mb-8 flex items-center justify-between"><div><p class="eyebrow text-wire">Live desk //</p><h2 class="mt-1 font-serif text-2xl font-medium text-ink sm:text-3xl">Latest intelligence</h2></div><a href={sitePath("/news/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">View all</a></div><div class="grid grid-cols-1 gap-10"><FeaturedArticle href={sitePath(`/${featured.data.category}/${featured.slug}/`)} title={featured.data.title} description={featured.data.description} category={featured.data.category} pubDate={featured.data.pubDate} readingTime={featured.data.readingTime} heroImage={featured.data.heroImage}/><div><div class="mb-1 flex items-center justify-between border-b border-line pb-3"><p class="data-label">Intelligence feed</p><p class="data-label">Latest coverage</p></div><div class="grid lg:grid-cols-2 lg:gap-x-10">{latest.map((entry) => <ArticleCard compact href={sitePath(`/${entry.data.category}/${entry.slug}/`)} title={entry.data.title} description={entry.data.description} category={entry.data.category} pubDate={entry.data.pubDate} readingTime={entry.data.readingTime}/>)}</div></div></div></section>}
  <section class="border-b border-line"><div class="wire-container py-10 sm:py-12"><div class="grid gap-px border border-line bg-line sm:grid-cols-3"><a href={sitePath("/learn/rwa-crypto-explained/")} data-analytics-placement="homepage-start-rwa" class="group bg-bg p-5 hover:bg-surface"><p class="data-label text-wire">01 // Understand</p><h2 class="mt-2 font-serif text-xl text-ink group-hover:text-wire">What are RWAs?</h2><p class="mt-2 text-xs leading-5 text-ink-muted">Start with the market, the terminology and why assets are moving onchain.</p></a><a href={sitePath("/topics/tokenized-securities/")} data-analytics-placement="homepage-start-topic" class="group bg-bg p-5 hover:bg-surface"><p class="data-label text-wire">02 // Follow</p><h2 class="mt-2 font-serif text-xl text-ink group-hover:text-wire">Track a market theme</h2><p class="mt-2 text-xs leading-5 text-ink-muted">Move from headlines into connected coverage of tokenized securities.</p></a><a href={sitePath("/projects/")} data-analytics-placement="homepage-start-projects" class="group bg-bg p-5 hover:bg-surface"><p class="data-label text-wire">03 // Research</p><h2 class="mt-2 font-serif text-xl text-ink group-hover:text-wire">Map the infrastructure</h2><p class="mt-2 text-xs leading-5 text-ink-muted">Compare the projects building the rails of tokenized finance.</p></a></div></div></section>
  <section class="wire-container py-14 sm:py-20"><div class="mb-8 flex items-center justify-between"><div><p class="data-label text-wire">New to the market?</p><h2 class="mt-2 font-serif text-2xl font-medium text-ink sm:text-3xl">Learn the fundamentals</h2></div><a href={sitePath("/learn/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">View all</a></div><div class="grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">{learnArticles.map((entry) => <ArticleCard compact href={sitePath(`/${entry.data.category}/${entry.slug}/`)} title={entry.data.title} description={entry.data.description} category={entry.data.category} pubDate={entry.data.pubDate} readingTime={entry.data.readingTime}/>)}</div></section>
  <section class="border-t border-line bg-surface"><div class="wire-container py-14 sm:py-20"><div class="mb-8 flex items-center justify-between"><div><p class="data-label text-wire">Go deeper</p><h2 class="mt-2 font-serif text-2xl font-medium text-ink sm:text-3xl">Explore the infrastructure</h2></div><a href={sitePath("/projects/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">View all</a></div><div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">{projectArticles.map((entry) => <ProjectCard name={entry.data.title.replace(/ Explained$/, "")} category="Infrastructure" description={entry.data.description} href={sitePath(`/${entry.data.category}/${entry.slug}/`)}/>)}</div></div></section>
  <section class="border-t border-line"><div class="wire-container py-12 sm:py-16"><div class="grid gap-7 border border-line bg-[linear-gradient(120deg,rgba(46,212,122,.07),transparent_55%)] p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center"><div><p class="eyebrow text-wire">Trading platform guide // Partner</p><h2 class="mt-2 font-serif text-2xl text-ink sm:text-3xl">Considering Bitunix? Check the details first.</h2><p class="mt-3 max-w-2xl text-sm leading-6 text-ink-muted">Our independent guide covers standard fees, futures, copy trading and the key risks to review before opening an account. RWA Wire has an affiliate partnership with Bitunix.</p></div><div class="flex flex-wrap gap-3 lg:justify-end"><a href={sitePath("/bitunix/")} data-analytics-placement="homepage-bitunix-guide" class="inline-flex rounded bg-wire px-5 py-3 text-sm font-semibold text-bg hover:bg-wire/90">Read the Bitunix guide →</a><a href={sitePath("/affiliate-disclosure/")} class="inline-flex border border-line px-5 py-3 text-sm font-semibold text-ink hover:border-wire">Disclosure</a></div></div></div></section>
  <div class="wire-container py-10"><NewsletterSignup placement="homepage-newsletter" /></div>
  <TelegramCTA />
</BaseLayout>
