---
import { sitePath } from "../utils/paths";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FeaturedArticle from "@/components/FeaturedArticle.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import CategoryCard from "@/components/CategoryCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import TelegramCTA from "@/components/TelegramCTA.astro";
import { CATEGORIES, TELEGRAM_URL } from "@/config/site";

const allArticles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = allArticles;
const latest = rest.slice(0, 4);

const learnArticles = allArticles.filter((a) => a.data.category === "learn").slice(0, 6);
const projectArticles = allArticles.filter((a) => a.data.category === "projects").slice(0, 5);

const exploreCategories: Array<keyof typeof CATEGORIES> = [
  "rwa",
  "tokenization",
  "institutions",
  "markets",
];
---

<BaseLayout
  title="RWA Wire — The intelligence layer for the tokenized economy"
  description="News, research and explainers on real-world assets, tokenization and the infrastructure transforming global finance."
>
  <!-- HERO -->
  <section class="border-b border-line">
    <div class="wire-container py-16 sm:py-24">
      <p class="eyebrow text-wire">RWA &middot; Tokenization &middot; Institutions &middot; Markets</p>
      <h1 class="mt-5 max-w-3xl font-serif text-4xl font-medium leading-[1.08] text-ink sm:text-5xl lg:text-6xl">
        The financial system is moving onchain.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">
        News, research and explainers on real-world assets, tokenization and
        the infrastructure transforming global finance.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href={sitePath("/news/")}
          class="rounded bg-wire px-6 py-3 text-sm font-semibold text-bg hover:bg-wire/90"
        >
          Explore the latest
        </a>
        <a
          href={TELEGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded border border-line px-6 py-3 text-sm font-semibold text-ink hover:border-wire/50 hover:text-wire"
        >
          Join Telegram
        </a>
      </div>
    </div>
  </section>

  <!-- LATEST -->
  {
    featured && (
      <section class="wire-container py-14 sm:py-20">
        <div class="mb-8 flex items-center justify-between">
          <h2 class="font-serif text-2xl font-medium text-ink sm:text-3xl">Latest</h2>
          <a href={sitePath("/news/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">
            View all
          </a>
        </div>

        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.15fr_1fr]">
          <FeaturedArticle
            href={sitePath(`/${featured.data.category}/${featured.slug}/`)}
            title={featured.data.title}
            description={featured.data.description}
            category={featured.data.category}
            pubDate={featured.data.pubDate}
            readingTime={featured.data.readingTime}
          />
          <div class="divide-y divide-line">
            {latest.map((entry) => (
              <ArticleCard
                compact
                href={sitePath(`/${entry.data.category}/${entry.slug}/`)}
                title={entry.data.title}
                description={entry.data.description}
                category={entry.data.category}
                pubDate={entry.data.pubDate}
                readingTime={entry.data.readingTime}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- EXPLORE -->
  <section class="border-t border-line bg-surface">
    <div class="wire-container py-14 sm:py-20">
      <h2 class="mb-8 font-serif text-2xl font-medium text-ink sm:text-3xl">Explore</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          exploreCategories.map((slug) => (
            <CategoryCard label={CATEGORIES[slug].label} description={CATEGORIES[slug].description} href={sitePath(`/${slug}/`)} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- LEARN -->
  <section class="wire-container py-14 sm:py-20">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="font-serif text-2xl font-medium text-ink sm:text-3xl">Learn</h2>
      <a href={sitePath("/learn/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">
        View all
      </a>
    </div>
    <div class="grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        learnArticles.map((entry) => (
          <ArticleCard
            compact
            href={sitePath(`/${entry.data.category}/${entry.slug}/`)}
            title={entry.data.title}
            description={entry.data.description}
            category={entry.data.category}
            pubDate={entry.data.pubDate}
            readingTime={entry.data.readingTime}
          />
        ))
      }
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="border-t border-line bg-surface">
    <div class="wire-container py-14 sm:py-20">
      <div class="mb-8 flex items-center justify-between">
        <h2 class="font-serif text-2xl font-medium text-ink sm:text-3xl">Projects</h2>
        <a href={sitePath("/projects/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">
          View all
        </a>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          projectArticles.map((entry) => (
            <ProjectCard
              name={entry.data.title.replace(/ Explained$/, "")}
              category="Infrastructure"
              description={entry.data.description}
              href={sitePath(`/${entry.data.category}/${entry.slug}/`)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <TelegramCTA />
</BaseLayout>
