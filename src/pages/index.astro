---
import { sitePath } from "../utils/paths";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FeaturedArticle from "@/components/FeaturedArticle.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import TelegramCTA from "@/components/TelegramCTA.astro";
 

const allArticles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const editorialArticles = allArticles.filter(
  (a) =>
    ["news", "rwa", "tokenization", "institutions", "markets"].includes(a.data.category) &&
    a.data.type !== "EXPLAINER"
);
const [featured, ...editorialRest] = editorialArticles;
const latest = editorialRest.slice(0, 6);

const learnArticles = allArticles.filter((a) => a.data.category === "learn").slice(0, 6);
const projectArticles = allArticles.filter((a) => a.data.category === "projects").slice(0, 5);

---

<BaseLayout
  title="RWA Wire — The intelligence layer for the tokenized economy"
  description="News, research and explainers on real-world assets, tokenization and the infrastructure transforming global finance."
>
  <!-- START HERE -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_10%,rgba(46,212,122,.10),transparent_34%),linear-gradient(180deg,rgba(17,21,26,.35),transparent_75%)]"></div>
    <div class="wire-container relative py-12 sm:py-16">
      <p class="eyebrow text-wire">RWA Wire // Start here</p>
      <h1 class="mt-4 max-w-4xl font-serif text-4xl font-medium leading-[.98] tracking-[-.025em] text-ink sm:text-5xl lg:text-6xl">Understand how traditional finance is moving <span class="text-ink-muted">onchain.</span></h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-muted">Follow the latest institutional moves, learn the fundamentals, or explore the companies building tokenized finance.</p>
      <div class="mt-7 grid gap-3 sm:grid-cols-3">
        <a href="#latest" class="group border border-line bg-bg/70 p-4 hover:border-wire/60"><span class="font-mono text-[10px] text-wire">01 // TODAY</span><p class="mt-2 text-sm font-medium text-ink">See what changed</p><p class="mt-1 text-xs text-ink-muted">Latest news and market developments.</p></a>
        <a href="/learn/" class="group border border-line bg-bg/70 p-4 hover:border-wire/60"><span class="font-mono text-[10px] text-wire">02 // NEW HERE</span><p class="mt-2 text-sm font-medium text-ink">Learn the basics</p><p class="mt-1 text-xs text-ink-muted">Plain-English guides to RWA and tokenization.</p></a>
        <a href="/projects/" class="group border border-line bg-bg/70 p-4 hover:border-wire/60"><span class="font-mono text-[10px] text-wire">03 // GO DEEPER</span><p class="mt-2 text-sm font-medium text-ink">Explore the infrastructure</p><p class="mt-1 text-xs text-ink-muted">Projects, institutions and connected research.</p></a>
      </div>
    </div>
  </section>

  <!-- LATEST -->
  {
    featured && (
      <section id="latest" class="wire-container py-12 sm:py-16">
        <div class="mb-8 flex items-center justify-between">
          <div><p class="eyebrow text-wire">Live desk //</p><h2 class="mt-1 font-serif text-2xl font-medium text-ink sm:text-3xl">Latest intelligence</h2></div>
          <a href={sitePath("/news/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">
            View all
          </a>
        </div>

        <div class="grid grid-cols-1 gap-10">
          <FeaturedArticle
            href={sitePath(`/${featured.data.category}/${featured.slug}/`)}
            title={featured.data.title}
            description={featured.data.description}
            category={featured.data.category}
            pubDate={featured.data.pubDate}
            readingTime={featured.data.readingTime}
            heroImage={featured.data.heroImage}
          />
          <div>
            <div class="mb-1 flex items-center justify-between border-b border-line pb-3">
              <p class="data-label">Intelligence feed</p>
              <p class="data-label">Latest coverage</p>
            </div>
            <div class="grid lg:grid-cols-2 lg:gap-x-10">
              {latest.map((entry) => (
                <ArticleCard
                  compact
                  href={sitePath(`/${entry.data.category}/${entry.slug}/`)}
                  title={entry.data.title}
                  description={entry.data.description}
                  category={entry.data.category}
                  pubDate={entry.data.pubDate}
                  readingTime={entry.data.readingTime}
                />
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- AUDIENCE SIGNAL -->
  <section class="border-t border-line">
    <div class="wire-container py-8">
      <TelegramCTA compact />
    </div>
  </section>

  <!-- LEARN -->
  <section class="wire-container py-14 sm:py-20">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="font-serif text-2xl font-medium text-ink sm:text-3xl">Learn</h2>
      <a href={sitePath("/learn/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">
        View all
      </a>
    </div>
    <div class="grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        learnArticles.map((entry) => (
          <ArticleCard
            compact
            href={sitePath(`/${entry.data.category}/${entry.slug}/`)}
            title={entry.data.title}
            description={entry.data.description}
            category={entry.data.category}
            pubDate={entry.data.pubDate}
            readingTime={entry.data.readingTime}
          />
        ))
      }
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="border-t border-line bg-surface">
    <div class="wire-container py-14 sm:py-20">
      <div class="mb-8 flex items-center justify-between">
        <h2 class="font-serif text-2xl font-medium text-ink sm:text-3xl">Projects</h2>
        <a href={sitePath("/projects/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">
          View all
        </a>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          projectArticles.map((entry) => (
            <ProjectCard
              name={entry.data.title.replace(/ Explained$/, "")}
              category="Infrastructure"
              description={entry.data.description}
              href={sitePath(`/${entry.data.category}/${entry.slug}/`)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <TelegramCTA />
</BaseLayout>
