---
import { sitePath } from "../utils/paths";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FeaturedArticle from "@/components/FeaturedArticle.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import TelegramCTA from "@/components/TelegramCTA.astro";
import markets from "../../public/data/markets.json";
import DailyIntelligence from "@/components/DailyIntelligence.astro";
import HomeWatchlist from "@/components/HomeWatchlist.astro";

const allArticles = (await getCollection("articles", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const editorialArticles = allArticles.filter((a) => ["news", "rwa", "tokenization", "institutions", "markets"].includes(a.data.category) && a.data.type !== "EXPLAINER");
const [featured, ...editorialRest] = editorialArticles;
const latest = editorialRest.slice(0, 4);
const learnArticles = allArticles.filter((a) => a.data.category === "learn").slice(0, 3);
const projectArticles = allArticles.filter((a) => a.data.category === "projects").slice(0, 3);
const marketEntries=Object.entries(markets.assets??{});
const priced=marketEntries.filter(([,a])=>typeof a.usd==="number"&&typeof a.usd_24h_change==="number"&&Number.isFinite(a.usd)&&Number.isFinite(a.usd_24h_change));
const advancing=priced.filter(([,a])=>(a.usd_24h_change??0)>0).length;
const averageMove=priced.length?priced.reduce((sum,[,a])=>sum+(a.usd_24h_change??0),0)/priced.length:0;
const movers=[...priced].sort((a,b)=>Math.abs(b[1].usd_24h_change??0)-Math.abs(a[1].usd_24h_change??0)).slice(0,3);
const maxMove=Math.max(1,...movers.map(([,a])=>Math.abs(a.usd_24h_change??0)));
const marketDate=new Date(markets.fetchedAt);
const marketAgeHours=(Date.now()-marketDate.valueOf())/3600000;
const marketStamp=Number.isFinite(marketDate.valueOf())?marketDate.toLocaleString("en-GB",{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit",timeZone:"UTC"})+" UTC":"Unknown snapshot time";
const recentReports=editorialArticles.filter(a=>a.data.pubDate.valueOf()<=Date.now()&&Date.now()-a.data.pubDate.valueOf()<7*86400000);
---
<BaseLayout title="RWA News & Asset Tokenization Research" description="Follow real-world asset (RWA) tokenization news, institutional developments and source-led research. Understand tokenized stocks, funds, Treasuries and deposits.">
  <section class="border-b border-line bg-[radial-gradient(ellipse_at_72%_8%,rgba(85,219,161,.09),transparent_58%)]">
    <div class="wire-container py-7 sm:py-10">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-4">
        <p class="wire-kicker">RWA Wire / Intelligence desk</p>
        <div class="flex flex-wrap items-center gap-3 text-[11px] text-ink-muted"><span class="inline-flex items-center gap-2"><span class:list={["h-1.5 w-1.5 rounded-full",marketAgeHours<2?"bg-wire":"bg-amber-400"]}></span>{marketAgeHours<2?"Recent snapshot":"Delayed market data"}</span><span class="font-mono">{marketStamp}</span></div>
      </div>
      <div class="mt-7 grid gap-5 lg:grid-cols-[minmax(0,1.45fr)_minmax(310px,.8fr)]">
        <div class="flex flex-col justify-between rounded-2xl border border-line bg-surface/70 p-6 sm:p-8" data-reveal>
          <div><p class="data-label text-wire">Your daily research briefing</p><h1 class="mt-4 max-w-2xl font-sans text-3xl font-bold leading-[1.1] tracking-[-.04em] text-ink sm:text-5xl">Understand the tokenized economy<span class="text-wire">.</span></h1><p class="mt-4 max-w-xl text-sm leading-6 text-ink-muted sm:text-base">Track your projects, monitor market shifts and follow evidence-backed developments — all in one workspace.</p></div>
          <div class="mt-7 flex flex-wrap gap-3"><a class="wire-action wire-action-primary" href={sitePath("/intelligence/")}>Explore intelligence ↗</a><a class="wire-action" href={sitePath("/radar/")}>Browse signals ↗</a></div>
        </div>
        <div class="grid grid-cols-2 gap-3" data-reveal>
          <div class="wire-panel flex flex-col justify-between p-4 sm:p-5"><p class="data-label">Tracked tokens with data</p><div><p class="mt-6 font-mono text-3xl font-semibold text-ink">{priced.length}<span class="ml-1 text-sm text-ink-muted">/ {marketEntries.length}</span></p><p class="mt-2 text-xs text-ink-muted">Available provider prices</p></div></div>
          <div class="wire-panel flex flex-col justify-between p-4 sm:p-5"><p class="data-label">24h breadth</p><div><p class="mt-6 font-mono text-3xl font-semibold text-ink">{advancing}<span class="mx-1 text-lg text-ink-muted">/</span>{priced.length}</p><p class="mt-2 text-xs text-ink-muted">Tokens advancing</p></div></div>
          <div class="wire-panel flex flex-col justify-between p-4 sm:p-5"><p class="data-label">Equal-weight 24h move</p><div><p class:list={["mt-6 font-mono text-3xl font-semibold",averageMove>=0?"text-wire":"text-rose-400"]}>{priced.length?(averageMove>=0?"+":"")+averageMove.toFixed(2)+"%":"N/A"}</p><p class="mt-2 text-xs text-ink-muted">Available tracked tokens</p></div></div>
          <div class="wire-panel flex flex-col justify-between p-4 sm:p-5"><p class="data-label">Latest reporting</p><div><p class="mt-6 font-mono text-3xl font-semibold text-ink">{recentReports.length}</p><p class="mt-2 text-xs text-ink-muted">Published in past 7 days</p></div></div>
        </div>
      </div>
      <div class="mt-4 grid gap-3 lg:grid-cols-[minmax(0,1.45fr)_minmax(310px,.8fr)]">
        <div class="wire-panel overflow-hidden" data-reveal><div class="flex items-center justify-between gap-2 border-b border-line px-5 py-3"><p class="data-label">Market movers / 24 hours</p><a class="text-xs font-semibold text-wire" href={sitePath("/intelligence/")}>Full screener ↗</a></div><div class="grid divide-y divide-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">{movers.map(([id,a])=><div class="px-5 py-4"><p class="truncate text-xs font-semibold uppercase text-ink">{id.replaceAll("-"," ")}</p><p class:list={["mt-2 font-mono text-xl font-semibold",(a.usd_24h_change??0)>=0?"text-wire":"text-rose-400"]}>{(a.usd_24h_change??0)>=0?"+":""}{(a.usd_24h_change??0).toFixed(2)}%</p><div class="mt-3 h-1 overflow-hidden rounded-full bg-bg"><div class:list={["h-full rounded-full",(a.usd_24h_change??0)>=0?"bg-wire":"bg-rose-400"]} style={`width:${Math.max(3,Math.abs(a.usd_24h_change??0)/maxMove*100)}%`}></div></div></div>)}</div></div>
        <div class="wire-panel flex flex-col justify-between p-5" data-reveal><div><p class="data-label">Desk note</p><p class="mt-3 text-sm font-semibold leading-6 text-ink">Market moves are not evidence of tokenization adoption.</p><p class="mt-2 text-xs leading-5 text-ink-muted">Snapshot from {markets.source}. Review original reporting before drawing conclusions.</p></div><a class="mt-4 text-xs font-semibold text-wire" href={sitePath("/pulse/")}>Read the daily Pulse ↗</a></div>
      </div>
    </div>
  </section>
  <HomeWatchlist />
  <DailyIntelligence />
  {featured && <section id="latest" class="wire-container py-12 sm:py-16"><div class="mb-8 flex items-center justify-between"><div><p class="eyebrow text-wire">Live desk //</p><h2 class="mt-1 font-sans text-2xl font-semibold text-ink sm:text-3xl">Latest intelligence</h2></div><a href={sitePath("/news/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">View all</a></div><div data-reveal class="grid grid-cols-1 gap-10"><FeaturedArticle href={sitePath(`/${featured.data.category}/${featured.slug}/`)} title={featured.data.title} description={featured.data.description} category={featured.data.category} pubDate={featured.data.pubDate} readingTime={featured.data.readingTime} heroImage={featured.data.heroImage}/><div><div class="mb-1 flex items-center justify-between border-b border-line pb-3"><p class="data-label">Intelligence feed</p><p class="data-label">Latest coverage</p></div><div class="grid lg:grid-cols-2 lg:gap-x-10">{latest.map((entry) => <ArticleCard compact href={sitePath(`/${entry.data.category}/${entry.slug}/`)} title={entry.data.title} description={entry.data.description} category={entry.data.category} pubDate={entry.data.pubDate} readingTime={entry.data.readingTime}/>)}</div></div></div></section>}
  <section class="border-b border-line"><div class="wire-container py-8 sm:py-10"><div class="mb-4 flex flex-wrap items-center justify-between gap-3"><div><p class="wire-kicker">Research pathways</p><h2 class="mt-2 font-sans text-xl font-semibold text-ink sm:text-2xl">Explore by objective</h2></div><span class="text-xs text-ink-muted">Learn · Follow · Research</span></div><div class="grid gap-3 sm:grid-cols-3"><a href={sitePath("/learn/rwa-crypto-explained/")} data-analytics-placement="homepage-start-rwa" class="group wire-panel wire-panel-hover p-5"><p class="data-label text-wire">01 // Understand</p><h2 class="mt-2 font-sans text-lg font-semibold text-ink group-hover:text-wire">What are RWAs?</h2><p class="mt-2 text-xs leading-5 text-ink-muted">Start with the market, the terminology and why assets are moving onchain.</p></a><a href={sitePath("/topics/tokenized-securities/")} data-analytics-placement="homepage-start-topic" class="group wire-panel wire-panel-hover p-5"><p class="data-label text-wire">02 // Follow</p><h2 class="mt-2 font-sans text-lg font-semibold text-ink group-hover:text-wire">Track a market theme</h2><p class="mt-2 text-xs leading-5 text-ink-muted">Move from headlines into connected coverage of tokenized securities.</p></a><a href={sitePath("/projects/")} data-analytics-placement="homepage-start-projects" class="group wire-panel wire-panel-hover p-5"><p class="data-label text-wire">03 // Research</p><h2 class="mt-2 font-sans text-lg font-semibold text-ink group-hover:text-wire">Map the infrastructure</h2><p class="mt-2 text-xs leading-5 text-ink-muted">Compare the projects building the rails of tokenized finance.</p></a></div></div></section>
  <section class="wire-container py-14 sm:py-20"><div class="mb-8 flex items-center justify-between"><div><p class="data-label text-wire">New to the market?</p><h2 class="mt-2 font-sans text-2xl font-semibold text-ink sm:text-3xl">Learn the fundamentals</h2></div><a href={sitePath("/learn/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">View all</a></div><div class="grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">{learnArticles.map((entry) => <ArticleCard compact href={sitePath(`/${entry.data.category}/${entry.slug}/`)} title={entry.data.title} description={entry.data.description} category={entry.data.category} pubDate={entry.data.pubDate} readingTime={entry.data.readingTime}/>)}</div></section>
  <section class="border-t border-line bg-surface"><div class="wire-container py-14 sm:py-20"><div class="mb-8 flex items-center justify-between"><div><p class="data-label text-wire">Go deeper</p><h2 class="mt-2 font-sans text-2xl font-semibold text-ink sm:text-3xl">Explore the infrastructure</h2></div><a href={sitePath("/projects/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">View all</a></div><div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">{projectArticles.map((entry) => <ProjectCard name={entry.data.title.replace(/ Explained$/, "")} category="Infrastructure" description={entry.data.description} href={sitePath(`/${entry.data.category}/${entry.slug}/`)}/>)}</div></div></section>
  <section class="border-t border-line"><div class="wire-container py-12 sm:py-16"><div class="grid gap-7 border border-line bg-[linear-gradient(120deg,rgba(46,212,122,.07),transparent_55%)] p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center"><div><p class="eyebrow text-wire">Trading platform guide // Partner</p><h2 class="mt-2 font-serif text-2xl text-ink sm:text-3xl">Considering Bitunix? Check the details first.</h2><p class="mt-3 max-w-2xl text-sm leading-6 text-ink-muted">Our independent guide covers standard fees, futures, copy trading and the key risks to review before opening an account. RWA Wire has an affiliate partnership with Bitunix.</p></div><div class="flex flex-wrap gap-3 lg:justify-end"><a href={sitePath("/bitunix/")} data-analytics-placement="homepage-bitunix-guide" class="inline-flex rounded bg-wire px-5 py-3 text-sm font-semibold text-bg hover:bg-wire/90">Read the Bitunix guide →</a><a href={sitePath("/affiliate-disclosure/")} class="inline-flex border border-line px-5 py-3 text-sm font-semibold text-ink hover:border-wire">Disclosure</a></div></div></div></section>
  <div class="wire-container py-10"><NewsletterSignup placement="homepage-newsletter" /></div>
  <TelegramCTA />
</BaseLayout>
