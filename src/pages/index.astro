---
import { sitePath } from "../utils/paths";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FeaturedArticle from "@/components/FeaturedArticle.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import CategoryCard from "@/components/CategoryCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import TelegramCTA from "@/components/TelegramCTA.astro";
import { CATEGORIES, TELEGRAM_URL } from "@/config/site";

const allArticles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const editorialArticles = allArticles.filter(
  (a) =>
    ["news", "rwa", "tokenization", "institutions", "markets"].includes(a.data.category) &&
    a.data.type !== "EXPLAINER"
);
const [featured, ...editorialRest] = editorialArticles;
const latest = editorialRest.slice(0, 6);

const learnArticles = allArticles.filter((a) => a.data.category === "learn").slice(0, 6);
const projectArticles = allArticles.filter((a) => a.data.category === "projects").slice(0, 5);

const exploreCategories: Array<keyof typeof CATEGORIES> = [
  "rwa",
  "tokenization",
  "institutions",
  "markets",
];
---

<BaseLayout
  title="RWA Wire — The intelligence layer for the tokenized economy"
  description="News, research and explainers on real-world assets, tokenization and the infrastructure transforming global finance."
>
  <!-- NEWSROOM MASTHEAD -->
  <section class="border-b border-line">
    <div class="wire-container py-10 sm:py-12">
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <p class="eyebrow text-wire">RWA · Tokenization · Institutions · Markets</p>
          <h1 class="mt-4 max-w-4xl font-serif text-4xl font-medium leading-[.98] tracking-[-.025em] text-ink sm:text-5xl lg:text-6xl">Intelligence for the<br/><span class="text-ink-muted">tokenized economy.</span></h1>
        </div>
        <div class="max-w-sm border-l border-line pl-5">
          <p class="data-label">RWA Wire // Briefing</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">Independent reporting on assets, institutions and infrastructure moving global finance onchain.</p>
          <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block text-[10px] font-semibold uppercase tracking-[.14em] text-wire">Get the wire →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- LATEST -->
  {
    featured && (
      <section class="wire-container py-12 sm:py-16">
        <div class="mb-8 flex items-center justify-between">
          <div><p class="eyebrow text-wire">Live desk //</p><h2 class="mt-1 font-serif text-2xl font-medium text-ink sm:text-3xl">Latest intelligence</h2></div>
          <a href={sitePath("/news/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">
            View all
          </a>
        </div>

        <div class="grid grid-cols-1 gap-10">
          <FeaturedArticle
            href={sitePath(`/${featured.data.category}/${featured.slug}/`)}
            title={featured.data.title}
            description={featured.data.description}
            category={featured.data.category}
            pubDate={featured.data.pubDate}
            readingTime={featured.data.readingTime}
            heroImage={featured.data.heroImage}
          />
          <div>
            <div class="mb-1 flex items-center justify-between border-b border-line pb-3">
              <p class="data-label">Intelligence feed</p>
              <p class="data-label">Latest coverage</p>
            </div>
            <div class="grid lg:grid-cols-2 lg:gap-x-10">
              {latest.map((entry) => (
                <ArticleCard
                  compact
                  href={sitePath(`/${entry.data.category}/${entry.slug}/`)}
                  title={entry.data.title}
                  description={entry.data.description}
                  category={entry.data.category}
                  pubDate={entry.data.pubDate}
                  readingTime={entry.data.readingTime}
                />
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- EXPLORE -->
  <section class="border-t border-line bg-surface">
    <div class="wire-container py-14 sm:py-20">
      <h2 class="mb-8 font-serif text-2xl font-medium text-ink sm:text-3xl">Explore</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          exploreCategories.map((slug) => (
            <CategoryCard label={CATEGORIES[slug].label} description={CATEGORIES[slug].description} href={sitePath(`/${slug}/`)} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- TOPIC INTELLIGENCE -->
  <section class="border-t border-line">
    <div class="wire-container py-12 sm:py-16">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"><div><p class="data-label text-wire">Research map</p><h2 class="mt-2 font-serif text-2xl font-medium text-ink sm:text-3xl">Explore intelligence by topic</h2><p class="mt-2 max-w-xl text-sm text-ink-muted">Connected research across the core markets and infrastructure shaping tokenized finance.</p></div><a href="/topics/" class="text-xs font-medium uppercase tracking-[.08em] text-wire">View topic map →</a></div>
      <div class="mt-7 flex flex-wrap gap-2">{[["Real-World Assets","real-world-assets"],["Tokenized Treasuries","tokenized-treasuries"],["Tokenized Securities","tokenized-securities"],["Private Credit","private-credit"],["Institutional Tokenization","institutional-tokenization"]].map(([label,slug])=><a href={`/topics/${slug}/`} class="border border-line px-4 py-2.5 text-[11px] uppercase tracking-[.08em] text-ink-muted hover:border-wire hover:text-wire">{label}</a>)}</div>
    </div>
  </section>

  <!-- LEARN -->
  <section class="wire-container py-14 sm:py-20">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="font-serif text-2xl font-medium text-ink sm:text-3xl">Learn</h2>
      <a href={sitePath("/learn/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">
        View all
      </a>
    </div>
    <div class="grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        learnArticles.map((entry) => (
          <ArticleCard
            compact
            href={sitePath(`/${entry.data.category}/${entry.slug}/`)}
            title={entry.data.title}
            description={entry.data.description}
            category={entry.data.category}
            pubDate={entry.data.pubDate}
            readingTime={entry.data.readingTime}
          />
        ))
      }
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="border-t border-line bg-surface">
    <div class="wire-container py-14 sm:py-20">
      <div class="mb-8 flex items-center justify-between">
        <h2 class="font-serif text-2xl font-medium text-ink sm:text-3xl">Projects</h2>
        <a href={sitePath("/projects/")} class="text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-wire">
          View all
        </a>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          projectArticles.map((entry) => (
            <ProjectCard
              name={entry.data.title.replace(/ Explained$/, "")}
              category="Infrastructure"
              description={entry.data.description}
              href={sitePath(`/${entry.data.category}/${entry.slug}/`)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <TelegramCTA />
</BaseLayout>
