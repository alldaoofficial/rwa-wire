---
import { sitePath } from "../utils/paths";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="This page could not be found." noindex={true}>
  <div class="wire-container flex min-h-[60vh] flex-col items-start justify-center py-20">
    <p class="eyebrow text-wire">404</p>
    <h1 class="mt-3 font-serif text-3xl font-medium text-ink sm:text-4xl">Page not found</h1>
    <p class="mt-3 max-w-md text-base text-ink-muted">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <a
      href={sitePath("/")}
      class="mt-8 inline-flex rounded bg-wire px-6 py-3 text-sm font-semibold text-bg hover:bg-wire/90"
    >
      Back to homepage
    </a>
  </div>
</BaseLayout>
