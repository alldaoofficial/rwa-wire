---
import { CATEGORIES, type CategorySlug } from "@/config/site";
interface Props { href:string; title:string; description:string; category:CategorySlug; pubDate:Date; readingTime:string; compact?:boolean; }
const {href,title,description,category,pubDate,readingTime,compact=false}=Astro.props;
const dateStr=pubDate.toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"});
---
<article class="group border-b border-line py-5 first:pt-0 last:border-b-0">
<a href={href} class="grid grid-cols-[72px_1fr] gap-4">
<div class="pt-0.5 text-[10px] font-medium uppercase tracking-[.08em] text-ink-muted"><time datetime={pubDate.toISOString()}>{dateStr.replace(",","")}</time></div>
<div><p class="mb-2 text-[10px] font-semibold uppercase tracking-[.14em] text-wire">{CATEGORIES[category].label} //</p><h3 class:list={["font-serif font-medium leading-[1.15] text-ink group-hover:text-wire",compact?"text-xl":"text-2xl"]}>{title}</h3>{!compact&&<p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-muted">{description}</p>}<p class="mt-3 text-[10px] uppercase tracking-[.1em] text-ink-muted">{readingTime}</p></div>
</a></article>