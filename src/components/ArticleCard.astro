---
import { CATEGORIES, type CategorySlug } from "@/config/site";

interface Props {
  href: string;
  title: string;
  description: string;
  category: CategorySlug;
  pubDate: Date;
  readingTime: string;
  compact?: boolean;
}
const { href, title, description, category, pubDate, readingTime, compact = false } = Astro.props;

const dateStr = pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<article class="group border-b border-line py-6 first:pt-0 last:border-b-0">
  <a href={href} class="block">
    <p class="eyebrow mb-2 text-wire">{CATEGORIES[category].label}</p>
    <h3
      class:list={[
        "font-serif font-medium text-ink group-hover:text-wire",
        compact ? "text-lg leading-snug" : "text-xl leading-snug sm:text-2xl",
      ]}
    >
      {title}
    </h3>
    {
      !compact && (
        <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-muted">{description}</p>
      )
    }
    <div class="mt-3 flex items-center gap-2 text-xs text-ink-muted">
      <time datetime={pubDate.toISOString()}>{dateStr}</time>
      <span aria-hidden="true">&middot;</span>
      <span>{readingTime}</span>
    </div>
  </a>
</article>
