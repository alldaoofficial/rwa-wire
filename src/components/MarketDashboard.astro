---
import markets from "../../public/data/markets.json";

type AssetMeta = { symbol: string; name: string };
const meta: Record<string, AssetMeta> = {
  "chainlink": { symbol: "LINK", name: "Chainlink" },
  "ondo-finance": { symbol: "ONDO", name: "Ondo" },
  "maple-finance": { symbol: "SYRUP", name: "Maple" },
  "plume": { symbol: "PLUME", name: "Plume" },
  "centrifuge": { symbol: "CFG", name: "Centrifuge" },
  "polymesh": { symbol: "POLYX", name: "Polymesh" },
  "goldfinch": { symbol: "GFI", name: "Goldfinch" },
  "clearpool": { symbol: "CPOOL", name: "Clearpool" },
};

const assets = Object.entries(markets.assets ?? {}).flatMap(([id, asset]) => {
  const price = asset.usd;
  const change = asset.usd_24h_change;
  if (typeof price !== "number" || !Number.isFinite(price) || typeof change !== "number" || !Number.isFinite(change)) return [];
  return [{
    id,
    ...(meta[id] ?? { symbol: id.toUpperCase(), name: id }),
    price,
    change,
    volume: typeof asset.usd_24h_vol === "number" && Number.isFinite(asset.usd_24h_vol) ? asset.usd_24h_vol : 0,
    marketCap: typeof asset.usd_market_cap === "number" && Number.isFinite(asset.usd_market_cap) ? asset.usd_market_cap : 0,
  }];
});

const ranked = [...assets].sort((a,b) => b.change - a.change);
const up = assets.filter((a) => a.change > 0).length;
const down = assets.filter((a) => a.change < 0).length;
const average = assets.length ? assets.reduce((sum,a) => sum + a.change, 0) / assets.length : 0;
const leader = ranked[0];
const movers = [...assets].sort((a,b)=>Math.abs(b.change)-Math.abs(a.change)).slice(0,8);
const largestMove=Math.max(1,...movers.map(a=>Math.abs(a.change)));
const totalVolume = assets.reduce((sum,a) => sum + a.volume, 0);
const breadth = assets.length ? up / assets.length : 0;
const read = breadth >= .75 ? "Broad strength" : down / Math.max(assets.length,1) >= .75 ? "Broad weakness" : "Mixed market";
const fetched = new Date(markets.fetchedAt);
const updated = Number.isNaN(fetched.valueOf()) ? "Latest snapshot" : fetched.toLocaleString("en-GB", { day:"2-digit", month:"short", hour:"2-digit", minute:"2-digit", timeZone:"UTC" }) + " UTC";

const price = (v: number) => v < 1 ? `$${v.toFixed(4)}` : `$${v.toFixed(2)}`;
const pct = (v: number) => `${v >= 0 ? "+" : ""}${v.toFixed(1)}%`;
const money = (v: number) => v >= 1e9 ? `$${(v/1e9).toFixed(1)}B` : v >= 1e6 ? `$${(v/1e6).toFixed(1)}M` : `$${(v/1e3).toFixed(0)}K`;
---

<section class="border-y border-line bg-bg/60" aria-labelledby="market-dashboard-title">
  <div class="wire-container py-10 sm:py-12">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="eyebrow text-wire">Market desk // cached snapshot</p><h2 id="market-dashboard-title" class="mt-1 font-serif text-2xl font-medium text-ink sm:text-3xl">RWA market at a glance</h2><p class="mt-2 max-w-xl text-sm text-ink-muted">A fast read on the tracked tokenized-finance market — before you dive into the stories.</p></div>
      <p class="font-mono text-[10px] uppercase tracking-[.08em] text-ink-muted">{markets.source} · {updated}</p>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
      <div class="wire-panel wire-panel-hover p-5 sm:p-6" data-reveal><p class="data-label">24h basket</p><p class:list={["mt-2 font-mono text-xl font-semibold", average >= 0 ? "text-wire" : "text-red-400"]}>{pct(average)}</p><p class="mt-1 text-xs text-ink-muted">Average move</p></div>
      <div class="wire-panel p-5 sm:p-6"><p class="data-label">Breadth</p><p class="mt-2 font-mono text-xl font-semibold text-ink">{up}/{assets.length}</p><p class="mt-1 text-xs text-ink-muted">Assets higher</p></div>
      <div class="wire-panel p-5 sm:p-6"><p class="data-label">Leader</p><p class="mt-2 font-mono text-xl font-semibold text-wire">{leader?.symbol ?? "—"}</p><p class="mt-1 text-xs text-ink-muted">{leader ? pct(leader.change) : "No data"}</p></div>
      <div class="wire-panel p-5 sm:p-6"><p class="data-label">24h volume</p><p class="mt-2 font-mono text-xl font-semibold text-ink">{money(totalVolume)}</p><p class="mt-1 text-xs text-ink-muted">Tracked basket</p></div>
    </div>
    <section class="mt-5 wire-panel p-5 sm:p-6" data-reveal aria-labelledby="pulse-movers-title">
      <div class="flex flex-wrap items-start justify-between gap-3"><div><p class="data-label text-wire">Market visualization / 24h</p><h3 id="pulse-movers-title" class="mt-2 text-xl font-semibold text-ink">Largest moves in the tracked basket</h3><p class="mt-1 text-xs leading-5 text-ink-muted">Ranked by absolute 24-hour percentage change. Green indicates gains; rose indicates declines.</p></div><span class="rounded-lg border border-line px-3 py-2 font-mono text-[10px] text-ink-muted">{updated}</span></div>
      {movers.length?<div class="mt-6 grid gap-3 sm:grid-cols-2">{movers.map(a=><div class="group rounded-lg border border-line/70 bg-bg/60 px-3 py-3 transition-colors hover:border-wire/40"><div class="flex items-center justify-between gap-3"><div><span class="font-mono text-sm font-semibold text-ink">{a.symbol}</span><span class="ml-2 text-xs text-ink-muted">{a.name}</span></div><span class:list={["font-mono text-sm font-semibold",a.change>=0?"text-wire":"text-rose-400"]}>{pct(a.change)}</span></div><div class="mt-3 h-2 overflow-hidden rounded-full bg-surface-raised"><div class:list={["pulse-move-bar h-full rounded-full",a.change>=0?"bg-wire":"bg-rose-400"]} style={`--move-width:${Math.max(2,Math.abs(a.change)/largestMove*100)}%`}></div></div></div>)}</div>:<p class="mt-5 text-sm text-ink-muted">No valid market movements are available in this snapshot.</p>}
      <p class="mt-4 text-xs text-ink-muted">Relative bar lengths compare movement magnitudes only. This is not a historical price chart or a measure of underlying tokenized assets.</p>
    </section>
    <div class="mt-5 grid gap-5 lg:grid-cols-[1fr_280px]">
      <div class="wire-panel overflow-hidden" data-reveal>
        <div class="grid grid-cols-[1fr_auto_auto] gap-4 border-b border-line px-4 py-3 font-mono text-[10px] uppercase tracking-[.08em] text-ink-muted sm:grid-cols-[1fr_110px_110px_120px]"><span>Asset</span><span class="hidden text-right sm:block">Price</span><span class="text-right">24h</span><span class="text-right">Volume</span></div>
        {ranked.map((asset) => <div class="grid grid-cols-[1fr_auto_auto] items-center gap-4 border-b border-line/70 px-4 py-3 last:border-0 sm:grid-cols-[1fr_110px_110px_120px]"><div class="min-w-0"><span class="font-mono text-sm font-semibold text-ink">{asset.symbol}</span><span class="ml-2 hidden text-xs text-ink-muted md:inline">{asset.name}</span></div><span class="hidden text-right font-mono text-xs text-ink-muted sm:block">{price(asset.price)}</span><span class:list={["text-right font-mono text-xs font-semibold", asset.change >= 0 ? "text-wire" : "text-red-400"]}>{pct(asset.change)}</span><span class="text-right font-mono text-xs text-ink-muted">{money(asset.volume)}</span></div>)}
      </div>
      <aside class="wire-panel p-6" data-reveal><p class="data-label text-wire">Market read</p><p class="mt-3 font-serif text-xl text-ink">{read}</p><p class="mt-2 text-sm leading-relaxed text-ink-muted">{up} of {assets.length} tracked assets are higher over 24h{leader ? `, led by ${leader.symbol} at ${pct(leader.change)}` : ""}.</p><div class="mt-5 border-t border-line pt-4"><div class="flex justify-between text-xs"><span class="text-ink-muted">Advancing</span><span class="font-mono text-wire">{up}</span></div><div class="mt-2 flex justify-between text-xs"><span class="text-ink-muted">Declining</span><span class="font-mono text-ink">{down}</span></div></div><a href="/markets/" class="mt-5 inline-flex text-xs font-medium uppercase tracking-[.08em] text-ink-muted hover:text-wire">Explore market coverage →</a></aside>
    </div>
  </div>
</section>

<style>
  .pulse-move-bar { width: var(--move-width); transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) {
    .pulse-move-bar { animation: pulse-grow 850ms cubic-bezier(.2,.8,.2,1) both; }
    @keyframes pulse-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }
</style>
