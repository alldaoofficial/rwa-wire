---
interface Props {
  label: string;
  value: string;
  note?: string;
}
const { label, value, note } = Astro.props;
---

<div class="border border-line p-5">
  <p class="eyebrow">{label}</p>
  <p class="mt-2 font-serif text-3xl font-medium text-ink">{value}</p>
  {note && <p class="mt-1 text-xs text-ink-muted">{note}</p>}
</div>
