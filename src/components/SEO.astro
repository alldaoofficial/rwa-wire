---
import {alternates, languageOf} from "@/i18n/routes";
import { SITE } from "@/config/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}
const {
  title,
  description,
  image = "/og-default.png",
  type = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const language = languageOf(Astro.url.pathname);
const alternatePages = alternates(Astro.url.pathname);
const locales = {en:"en_US",de:"de_DE",es:"es_ES",fr:"fr_FR"};
const canonicalURL = new URL(Astro.url.pathname, `${SITE.url}${SITE.base}/`).toString();
const imageURL = new URL(image, `${SITE.url}${SITE.base}/`).toString();
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{alternatePages.map(page => <link rel="alternate" hreflang={page.lang} href={new URL(page.path, SITE.url).toString()} />)}
{alternatePages.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alternatePages[0].path, SITE.url).toString()} />}
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
<meta name="author" content="RWA Wire Editorial Desk" />
<link rel="alternate" type="application/rss+xml" title="RWA Wire RSS" href={new URL("/rss.xml", SITE.url).toString()} />

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={locales[language]} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={title} />
