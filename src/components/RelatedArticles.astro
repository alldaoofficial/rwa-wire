---
import { CATEGORIES, type CategorySlug } from "@/config/site";

interface Item {
  href: string;
  title: string;
  category: CategorySlug;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="border-t border-line pt-10" aria-labelledby="related-heading">
      <h2 id="related-heading" class="eyebrow mb-5">
        Continue researching
      </h2>
      <div class="mb-5 flex items-end justify-between gap-4"><p class="max-w-md text-xs leading-5 text-ink-muted">Go from this story to the background, infrastructure and adjacent market developments that explain it.</p><a href="/topics/" data-analytics-placement="article-research-topics" class="hidden text-[10px] uppercase tracking-[.08em] text-wire hover:underline sm:block">Explore all topics →</a></div>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {items.map((item) => (
          <li class="border border-line p-4 transition-colors hover:border-wire/40">
            <a href={item.href} class="block">
              <p class="eyebrow mb-1.5 text-wire">{CATEGORIES[item.category].label}</p>
              <p class="font-serif text-sm font-medium leading-snug text-ink">{item.title}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
