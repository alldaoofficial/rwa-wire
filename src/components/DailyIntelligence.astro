---
import { getCollection } from "astro:content";
import markets from "../../public/data/markets.json";
import { sitePath } from "../utils/paths";

const articles=(await getCollection("articles",({data})=>!data.draft&&data.type!=="EXPLAINER"&&["news","rwa","tokenization","institutions","markets"].includes(data.category)))
  .sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const now=Date.now();
const latest=articles.filter(a=>a.data.pubDate.valueOf()<=now&&now-a.data.pubDate.valueOf()<86400000);
const previous=articles.filter(a=>a.data.pubDate.valueOf()<=now&&now-a.data.pubDate.valueOf()<7*86400000);
const selected=(latest.length?latest:previous).slice(0,6);
const windowLabel=latest.length?"Past 24 hours":"Past 7 days";
const categories: {label:string;test:RegExp}[]=[
 {label:"Institutions",test:/institution|bank|asset manager|custody|brokerage|partnership/i},
 {label:"Funds & treasuries",test:/fund|treasur|bond|money.market|credit|etf/i},
 {label:"Regulation",test:/regulat|compliance|licens|legislat|policy|sec\b|mica/i},
 {label:"Infrastructure",test:/launch|blockchain|settlement|network|platform|infrastructure/i}
];
const tags=(a:typeof articles[number])=>categories.filter(c=>c.test.test([a.data.title,a.data.description,...a.data.tags].join(" "))).map(c=>c.label);
const basket=Object.entries(markets.assets??{}).filter(([,v])=>typeof v.usd_24h_change==="number").map(([id,v])=>({id,change:v.usd_24h_change as number})).sort((a,b)=>Math.abs(b.change)-Math.abs(a.change)).slice(0,3);
const stamp=new Date(markets.fetchedAt);
const fresh=Number.isFinite(stamp.valueOf())&&now-stamp.valueOf()<2*3600000;
---
<section id="daily-intelligence" class="wire-container py-10 sm:py-14" aria-labelledby="daily-title">
 <div class="flex flex-wrap items-end justify-between gap-4">
  <div><p class="wire-kicker">RWA Wire / Daily intelligence</p><h2 id="daily-title" class="mt-2 font-sans text-2xl font-semibold text-ink sm:text-3xl">What changed today<span class="text-wire">?</span></h2><p class="mt-2 max-w-2xl text-sm text-ink-muted">A concise, source-led daily check-in. Market movements and editorial developments are reported separately — correlation does not imply causation.</p></div>
  <a href={sitePath("/radar/")} class="rounded-lg border border-line px-4 py-2 text-sm text-ink hover:border-wire hover:text-wire">Explore all signals ↗</a>
 </div>
 <div class="mt-6 grid gap-4 lg:grid-cols-[minmax(0,1.65fr)_minmax(280px,.85fr)]">
  <div class="rounded-2xl border border-line bg-surface p-5 sm:p-6" data-reveal>
   <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-4"><h3 class="font-semibold text-ink">Reported developments</h3><span class="text-xs text-ink-muted">{windowLabel} · {selected.length} stories</span></div>
   {selected.length?<div class="divide-y divide-line">{selected.map((a)=><a href={sitePath(`/${a.data.category}/${a.slug}/`)} class="group block py-4"><div class="flex flex-wrap gap-2 text-[10px] uppercase tracking-wider text-ink-muted"><span>{a.data.pubDate.toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric",timeZone:"UTC"})}</span>{tags(a).slice(0,2).map(t=><span class="rounded border border-line px-1.5 text-wire">{t}</span>)}</div><h4 class="mt-2 font-semibold leading-snug text-ink group-hover:text-wire">{a.data.title}</h4><p class="mt-1 line-clamp-2 text-xs leading-5 text-ink-muted">{a.data.description}</p></a>)}</div>:<p class="py-8 text-sm text-ink-muted">No recent qualifying reports are available. No events have been inferred.</p>}
   <p class="mt-3 text-xs leading-5 text-ink-muted">Topic labels are keyword-based and may overlap. Open each report to review the cited sources and context.</p>
  </div>
  <div class="grid content-start gap-4">
   <div class="rounded-2xl border border-line bg-surface p-5" data-reveal><div class="flex flex-wrap items-center justify-between gap-2"><h3 class="font-semibold text-ink">Market moves</h3><span class="text-[11px] text-ink-muted">{stamp.toLocaleDateString("en-GB",{timeZone:"UTC",day:"numeric",month:"short"})} UTC</span></div><p class="mt-2 text-xs text-ink-muted">Largest absolute 24h changes in the available tracked snapshot</p><div class="mt-5 space-y-4">{basket.map(a=><div class="flex items-center justify-between gap-2"><span class="text-sm font-semibold uppercase text-ink">{a.id.replaceAll("-"," ")}</span><span class:list={["font-mono text-sm font-semibold",a.change>=0?"text-wire":"text-rose-400"]}>{a.change>0?"+":""}{a.change.toFixed(2)}%</span></div>)}</div><p class="mt-5 text-xs text-ink-muted">{fresh?"Recent cached market snapshot":"Historical cached snapshot — may be stale"}. Not a live feed or explanation of price movements.</p></div>
   <div class="rounded-2xl border border-line bg-surface p-5" data-reveal><p class="text-[11px] font-bold uppercase tracking-wider text-wire">Your daily routine</p><h3 class="mt-2 font-semibold text-ink">Markets → Evidence → Context</h3><p class="mt-2 text-xs leading-5 text-ink-muted">Check the market snapshot, read verified developments, then follow the project or sector in Radar.</p><a href={sitePath("/pulse/")} class="mt-4 inline-block text-sm font-semibold text-wire">Open daily Pulse ↗</a></div>
  </div>
 </div>
</section>
