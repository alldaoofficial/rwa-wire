---
const assets = [
  { id: "chainlink", symbol: "LINK", name: "Chainlink", segment: "Oracle infrastructure" },
  { id: "ondo-finance", symbol: "ONDO", name: "Ondo", segment: "Tokenized securities" },
  { id: "maple-finance", symbol: "SYRUP", name: "Maple Finance", segment: "Private credit" },
  { id: "zebec-protocol", symbol: "ZBCN", name: "Zebec Network", segment: "Real-time payments" },
  { id: "plume", symbol: "PLUME", name: "Plume", segment: "RWA chain & infrastructure" },
  { id: "centrifuge", symbol: "CFG", name: "Centrifuge", segment: "RWA credit infrastructure" },
  { id: "polymesh", symbol: "POLYX", name: "Polymesh", segment: "Regulated asset infrastructure" },
  { id: "goldfinch", symbol: "GFI", name: "Goldfinch", segment: "Private credit" },
  { id: "clearpool", symbol: "CPOOL", name: "Clearpool", segment: "Institutional credit" },
  { id: "mantra-dao", symbol: "MANTRA", name: "MANTRA", segment: "RWA chain & compliance" },
];
---
<section class="mt-10 border-y border-line">
  <div class="grid gap-px border-b border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    <div class="bg-bg p-5"><p class="data-label">Market pulse</p><p id="pulse-state" class="mt-3 font-serif text-2xl text-ink">Loading</p><p class="mt-1 text-[10px] text-ink-muted">Breadth across tracked RWA protocols</p></div>
    <div class="bg-bg p-5"><p class="data-label">Advancers</p><p id="pulse-advancers" class="mt-3 font-mono text-2xl text-ink">—</p><p class="mt-1 text-[10px] text-ink-muted">Positive over 24H</p></div>
    <div class="bg-bg p-5"><p class="data-label">Top mover</p><p id="pulse-leader" class="mt-3 font-mono text-2xl text-ink">—</p><p id="pulse-leader-change" class="mt-1 text-[10px] text-ink-muted">24H change</p></div>
    <div class="bg-bg p-5"><p class="data-label">Tracked market cap</p><p id="pulse-cap" class="mt-3 font-mono text-2xl text-ink">—</p><p class="mt-1 text-[10px] text-ink-muted">Available assets in watchlist</p></div>
  </div>
  <div class="flex flex-col gap-3 border-b border-line py-5 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="data-label text-wire">RWA Markets // Live intelligence</p><h2 class="mt-2 font-serif text-2xl text-ink sm:text-3xl">Tokenization market watch</h2></div>
    <div class="text-left sm:text-right"><p id="markets-updated" class="data-label">Loading market data</p><p class="mt-1 text-[10px] text-ink-muted">USD · 24H market data</p></div>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[760px] border-collapse text-left">
      <thead><tr class="border-b border-line text-[10px] uppercase tracking-[.13em] text-ink-muted">
        <th class="py-4 pr-5 font-medium">Asset</th><th class="px-5 py-4 font-medium">Segment</th><th class="px-5 py-4 text-right font-medium">Price</th><th class="px-5 py-4 text-right font-medium">24H</th><th class="px-5 py-4 text-right font-medium">Market cap</th><th class="py-4 pl-5 text-right font-medium">24H volume</th>
      </tr></thead>
      <tbody id="rwa-market-table">
        {assets.map((a) => <tr class="border-b border-line/70" data-market-row={a.id}>
          <td class="py-5 pr-5"><span class="font-semibold text-ink">{a.symbol}</span><span class="ml-2 text-xs text-ink-muted">{a.name}</span></td>
          <td class="px-5 py-5 text-xs text-ink-muted">{a.segment}</td>
          <td class="market-price px-5 py-5 text-right font-mono text-sm text-ink">—</td>
          <td class="market-change px-5 py-5 text-right font-mono text-xs text-ink-muted">—</td>
          <td class="market-cap px-5 py-5 text-right font-mono text-xs text-ink-muted">—</td>
          <td class="market-volume py-5 pl-5 text-right font-mono text-xs text-ink-muted">—</td>
        </tr>)}
      </tbody>
    </table>
  </div>
  <div class="flex flex-col gap-2 py-4 text-[10px] text-ink-muted sm:flex-row sm:justify-between">
    <p>Market data is informational and may be delayed or unavailable.</p><p>Source: CoinGecko · Auto-refresh 60s</p>
  </div>
</section>
<script>
  const ids = ["chainlink","ondo-finance","maple-finance","zebec-protocol","plume","centrifuge","polymesh","goldfinch","clearpool","mantra-dao"];
  const endpoint = "https://api.coingecko.com/api/v3/simple/price?ids="+ids.join(",")+"&vs_currencies=usd&include_market_cap=true&include_24hr_vol=true&include_24hr_change=true&include_last_updated_at=true";
  const money=(n:number)=>n>=1e9?"$"+(n/1e9).toFixed(2)+"B":n>=1e6?"$"+(n/1e6).toFixed(1)+"M":n>=1e3?"$"+(n/1e3).toFixed(1)+"K":"$"+n.toFixed(2);
  const price=(n:number)=>n>=100?"$"+n.toLocaleString(undefined,{maximumFractionDigits:2}):n>=1?"$"+n.toFixed(2):"$"+n.toFixed(4);
  async function loadMarkets(){
    const updated=document.getElementById("markets-updated");
    try{
      const res=await fetch(endpoint,{headers:{accept:"application/json"}}); if(!res.ok) throw new Error();
      const data=await res.json(); let freshest=0; let advancers=0; let decliners=0; let capTotal=0; let capCount=0; let leader={symbol:"—",change:-Infinity};
      ids.forEach(id=>{const d=data[id],row=document.querySelector<HTMLElement>(`[data-market-row="${id}"]`);if(!d||!row)return;
        const set=(s:string,v:string)=>{const e=row.querySelector<HTMLElement>(s);if(e)e.textContent=v};
        set(".market-price",price(d.usd)); set(".market-cap",money(d.usd_market_cap)); set(".market-volume",money(d.usd_24h_vol));
        const ch=d.usd_24h_change,el=row.querySelector<HTMLElement>(".market-change"); if(el){el.textContent=Number.isFinite(ch)?(ch>=0?"+":"")+ch.toFixed(2)+"%":"—";el.className="market-change px-5 py-5 text-right font-mono text-xs "+(ch>=0?"text-wire":"text-red-400")}
        if(Number.isFinite(ch)){if(ch>0)advancers++;else if(ch<0)decliners++; const symbol=row.querySelector("td span")?.textContent||id.toUpperCase(); if(ch>leader.change)leader={symbol,change:ch};}
        if(Number.isFinite(d.usd_market_cap)){capTotal+=d.usd_market_cap;capCount++;}
        freshest=Math.max(freshest,d.last_updated_at||0);
      });
      if(updated) updated.textContent=freshest?"Updated "+new Date(freshest*1000).toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"}):"Market data live";
      const byId=(id:string)=>document.getElementById(id);
      const breadth=advancers+decliners; const ratio=breadth?advancers/breadth:.5;
      const state=ratio>=.7?"Risk-on":ratio<=.3?"Risk-off":"Mixed";
      if(byId("pulse-state")) byId("pulse-state")!.textContent=state;
      if(byId("pulse-advancers")) byId("pulse-advancers")!.textContent=advancers+"/"+breadth;
      if(byId("pulse-leader")) byId("pulse-leader")!.textContent=leader.symbol;
      if(byId("pulse-leader-change")) byId("pulse-leader-change")!.textContent=Number.isFinite(leader.change)?(leader.change>=0?"+":"")+leader.change.toFixed(2)+"% // 24H":"24H change";
      if(byId("pulse-cap")) byId("pulse-cap")!.textContent=capCount?money(capTotal):"—";
    }catch{if(updated)updated.textContent="Market data unavailable"}
  }
  loadMarkets(); window.setInterval(loadMarkets,60000);
</script>
