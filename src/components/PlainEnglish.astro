---
const terms = [
  ["RWA","Real-world assets","/glossary/#rwa"],
  ["Tokenization","Asset rights represented on blockchain rails","/glossary/#tokenization"],
  ["Onchain","Recorded on a blockchain","/glossary/#onchain"],
  ["Settlement","Final exchange of money and assets","/glossary/#settlement"],
];
---
<aside class="mx-auto mt-8 max-w-[720px] border border-line bg-surface/60 p-4 sm:p-5" aria-label="Plain English terminology">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div><p class="data-label text-wire">Plain English // Quick decode</p><p class="mt-2 max-w-md text-xs leading-relaxed text-ink-muted">New to tokenized finance? These four terms unlock most of the language used across RWA Wire.</p></div>
    <a href="/glossary/" class="shrink-0 text-[10px] uppercase tracking-[.1em] text-wire hover:underline">Full glossary →</a>
  </div>
  <div class="mt-4 grid gap-px bg-line sm:grid-cols-2">{terms.map(([term,meaning,href])=><a href={href} class="bg-bg p-3 hover:bg-surface"><span class="text-xs font-medium text-ink">{term}</span><span class="ml-2 text-[11px] text-ink-muted">= {meaning}</span></a>)}</div>
</aside>
