---
const assets = [
  { id: "ondo-finance", symbol: "ONDO" },
  { id: "chainlink", symbol: "LINK" },
  { id: "centrifuge", symbol: "CFG" },
  { id: "polymesh", symbol: "POLYX" },
];
const marketCacheUrl = `${import.meta.env.BASE_URL}data/markets.json`;
---
<section class="border-b border-line bg-surface/60" aria-label="RWA ecosystem token ticker" data-market-cache-url={marketCacheUrl}>
  <div class="wire-container flex min-h-10 items-center gap-4 overflow-x-auto py-1.5 [scrollbar-width:none]">
    <div class="flex shrink-0 items-center gap-2 border-r border-line pr-4"><span class="h-1.5 w-1.5 rounded-full bg-wire"></span><span class="text-[10px] font-semibold uppercase tracking-[.15em] text-wire">RWA Ecosystem // Market monitor</span></div>
    <div id="rwa-market-ticker" class="flex items-center gap-5">
      {assets.map((asset) => <div class="flex shrink-0 items-baseline gap-2" data-market={asset.id}><span class="text-[11px] font-semibold tracking-[.08em] text-ink">{asset.symbol}</span><span class="market-price font-mono text-[11px] text-ink-muted">—</span><span class="market-change font-mono text-[10px] text-ink-muted">—</span></div>)}
    </div>
    <span id="market-status" class="ml-auto shrink-0 text-[9px] uppercase tracking-[.1em] text-ink-muted">Loading</span>
  </div>
</section>
<script>
  const ids=["ondo-finance","chainlink","centrifuge","polymesh"];
  const ticker=document.querySelector<HTMLElement>("[data-market-cache-url]");
  const cacheUrl=ticker?.dataset.marketCacheUrl||"/data/markets.json";
  const liveUrl="https://api.coingecko.com/api/v3/simple/price?ids="+ids.join(",")+"&vs_currencies=usd&include_24hr_change=true&include_last_updated_at=true";
  const formatPrice=(n:number)=>n>=100?"$"+n.toLocaleString(undefined,{maximumFractionDigits:2}):n>=1?"$"+n.toFixed(2):"$"+n.toFixed(4);
  function render(data:Record<string,any>,label:string,requireQuoteTimestamp=false){
    let rendered=0;
    const now=Date.now();
    ids.forEach(id=>{
      const row=document.querySelector<HTMLElement>(`[data-market="${id}"]`);
      const item=data[id];
      if(!row||!item||!Number.isFinite(item.usd)||item.usd<=0)return;
      const quoteTime=Number(item.last_updated_at)*1000;
      if(requireQuoteTimestamp&&(!Number.isFinite(quoteTime)||quoteTime<=0||quoteTime>now||now-quoteTime>120*60000))return;
      rendered++;
      const price=row.querySelector<HTMLElement>(".market-price");
      const change=row.querySelector<HTMLElement>(".market-change");
      if(price)price.textContent=formatPrice(item.usd);
      const delta=item.usd_24h_change;
      if(change){
        change.textContent=Number.isFinite(delta)?(delta>=0?"+":"")+delta.toFixed(2)+"%":"—";
        change.className="market-change font-mono text-[10px] "+(!Number.isFinite(delta)?"text-ink-muted":delta>=0?"text-wire":"text-red-400");
      }
    });
    const status=document.getElementById("market-status");
    if(status&&rendered)status.textContent=label;
    return rendered;
  }
  async function refreshMarkets(){
    const status=document.getElementById("market-status");
    let cached=0;
    try{
      const res=await fetch(cacheUrl,{cache:"no-store"});
      if(res.ok){
        const payload=await res.json();
        const fetched=Date.parse(payload.fetchedAt??"");
        const age=Date.now()-fetched;
        const valid=Number.isFinite(age)&&age>=0;
        const label=!valid?"Snapshot · time unknown":age>120*60000?`Delayed snapshot · ${Math.round(age/3600000)}h old`:`Snapshot · ${Math.round(age/60000)}m old`;
        cached=render(payload.assets||{},label);
      }
    }catch{}
    try{
      const res=await fetch(liveUrl,{headers:{accept:"application/json"},cache:"no-store"});
      if(!res.ok)throw new Error("Provider unavailable");
      const data=await res.json();
      const fresh=render(data,"Provider quotes · updated within 2h",true);
      if(!fresh&&status&&!cached)status.textContent="Data temporarily unavailable";
    }catch{
      if(status&&!cached)status.textContent="Data temporarily unavailable";
    }
  }
  refreshMarkets();window.setInterval(refreshMarkets,60000);
</script>
