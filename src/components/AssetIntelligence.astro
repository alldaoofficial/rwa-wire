---
const metrics = [
  { label: "RWA Active AUM", value: "$30.52B", note: "+0.26% 24H", href: "https://defillama.com/rwa" },
  { label: "RWA Onchain AUM", value: "$33.31B", note: "91.6% active / onchain", href: "https://defillama.com/rwa" },
  { label: "DeFi Active TVL", value: "$3.76B", note: "12.3% utilization", href: "https://defillama.com/rwa" },
];
const categories = [
  ["Bond & MMF Funds","$16.71B","$18.41B"],
  ["Gold & Commodities","$5.81B","$6.01B"],
  ["Private Credit","$4.58B","$4.71B"],
  ["Stocks & Equities","$3.98B","$4.64B"],
  ["Crypto Funds","$476.98M","$477.15M"],
  ["Real Estate","$74.68M","$99.41M"],
];
const chains = [
  ["Ethereum","$14.50B"],["BSC","$4.88B"],["Stellar","$2.70B"],
  ["Solana","$2.45B"],["ZKsync Lite","$961.97M"],["Avalanche","$901.01M"],
  ["Arbitrum","$854.18M"],["Aptos","$768.58M"],
];
---
<section class="mt-14">
  <div class="flex items-end justify-between border-b border-line pb-5">
    <div><p class="data-label text-wire">Tokenized Asset Intelligence</p><h2 class="mt-2 font-serif text-2xl text-ink sm:text-3xl">The onchain real-world economy</h2></div>
    <span class="hidden text-[10px] uppercase tracking-[.12em] text-ink-muted sm:block">DefiLlama snapshot // USD</span>
  </div>
  <div class="grid gap-px bg-line sm:grid-cols-3">
    {metrics.map((m) => <a href={m.href} target="_blank" rel="noopener noreferrer" class="bg-bg p-6 hover:bg-surface">
      <p class="data-label">{m.label}</p><p class="mt-4 font-mono text-3xl text-ink">{m.value}</p><p class="mt-2 text-xs text-wire">{m.note}</p>
    </a>)}
  </div>

  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <div>
      <div class="flex items-center justify-between border-b border-line pb-3"><p class="data-label">RWA by category</p><a href="https://defillama.com/rwa/categories" target="_blank" rel="noopener noreferrer" class="text-[10px] uppercase tracking-[.1em] text-wire">Source ↗</a></div>
      <div>{categories.map((r,i) => <div class="grid grid-cols-[28px_1fr_auto_auto] gap-3 border-b border-line/70 py-3 text-xs"><span class="font-mono text-ink-muted">{String(i+1).padStart(2,"0")}</span><span class="text-ink">{r[0]}</span><span class="font-mono text-ink">{r[1]}</span><span class="hidden w-20 text-right font-mono text-ink-muted sm:block">{r[2]}</span></div>)}</div>
      <div class="mt-2 hidden grid-cols-[28px_1fr_auto_auto] gap-3 text-[9px] uppercase tracking-[.1em] text-ink-muted sm:grid"><span></span><span></span><span>Active</span><span class="text-right">Onchain</span></div>
    </div>
    <div>
      <div class="flex items-center justify-between border-b border-line pb-3"><p class="data-label">RWA by chain</p><a href="https://defillama.com/rwa/chains" target="_blank" rel="noopener noreferrer" class="text-[10px] uppercase tracking-[.1em] text-wire">Source ↗</a></div>
      <div>{chains.map((r,i) => <div class="grid grid-cols-[28px_1fr_auto] gap-3 border-b border-line/70 py-3 text-xs"><span class="font-mono text-ink-muted">{String(i+1).padStart(2,"0")}</span><span class="text-ink">{r[0]}</span><span class="font-mono text-ink">{r[1]}</span></div>)}</div>
      <p class="mt-2 text-right text-[9px] uppercase tracking-[.1em] text-ink-muted">Active RWA market cap</p>
    </div>
  </div>
  <p class="mt-6 text-[10px] leading-relaxed text-ink-muted">Data snapshot: DefiLlama RWA dashboards, checked 28 Sep 2026. Values may change between RWA Wire updates. Protocol-token prices above update separately in real time.</p>
</section>
