---
import { sitePath } from "../utils/paths";
import { SITE } from "@/config/site";

interface Crumb {
  label: string;
  href: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { label: "Home", href: "/" },
    ...items,
  ].map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.label,
    item: new URL(item.href, SITE.url + SITE.base + "/").toString(),
  })),
};
---

<nav aria-label="Breadcrumb" class="text-xs text-ink-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href={sitePath("/")} class="hover:text-ink">Home</a></li>
    {
      items.map((item, i) => (
        <>
          <li aria-hidden="true">/</li>
          <li>
            {i === items.length - 1 ? (
              <span class="text-ink" aria-current="page">{item.label}</span>
            ) : (
              <a href={sitePath(item.href)} class="hover:text-ink">{item.label}</a>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
