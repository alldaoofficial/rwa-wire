---
import { sitePath } from '@/utils/paths';
interface Props { placement: 'homepage-newsletter' | 'article-newsletter' | 'newsletter-page'; }
const { placement } = Astro.props;
const enabled = import.meta.env.PUBLIC_NEWSLETTER_ENABLED === 'true' && Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const endpoint = 'https://dqeakkrsbgxnexucuyld.supabase.co/functions/v1/newsletter';
---
{enabled && <section class="border border-line bg-surface p-6 sm:p-8" aria-labelledby={`${placement}-title`}>
  <p class="data-label text-wire">RWA Wire // In your inbox</p>
  <h2 id={`${placement}-title`} class="mt-2 font-serif text-2xl text-ink">Keep up with the tokenized economy.</h2>
  <p class="mt-3 text-sm leading-6 text-ink-muted">News, research and explainers from RWA Wire. Confirm your email to subscribe. Unsubscribe whenever you like.</p>
  <form data-newsletter-form data-placement={placement} data-endpoint={endpoint} class="mt-5 space-y-4">
    <label class="block text-sm text-ink" for={`${placement}-email`}>Email address</label>
    <input id={`${placement}-email`} name="email" type="email" required maxlength="254" autocomplete="email" class="w-full border border-line bg-bg p-3 text-ink focus:border-wire" />
    <div hidden aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <label class="flex items-start gap-3 text-xs leading-5 text-ink-muted"><input name="consent" type="checkbox" required class="mt-1" /><span>I agree to receive the RWA Wire newsletter by email. See our <a href={sitePath('/privacy/')} class="text-wire underline">privacy notice</a>.</span></label>
    <div data-newsletter-captcha data-sitekey={siteKey}></div>
    <button type="submit" class="bg-wire px-5 py-3 text-sm font-semibold text-bg disabled:opacity-50">Subscribe</button>
    <p data-newsletter-status role="status" aria-live="polite" class="text-sm text-ink-muted"></p>
    <noscript><p class="text-sm text-ink-muted">Please enable JavaScript to use this secure signup form.</p></noscript>
  </form>
</section>}
<script>
type AnalyticsWindow = Window & { rwaAnalytics?: { track: (event: string, target: string, metadata: Record<string, string>) => void }; turnstile?: { render: (el: HTMLElement, options: Record<string, unknown>) => string; reset: (id: string) => void } };
const win = window as AnalyticsWindow;
const forms = [...document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]')];
if (forms.length) {
  const loadCaptcha = () => {
    forms.forEach(form => {
      const el = form.querySelector<HTMLElement>('[data-newsletter-captcha]');
      if (!el || !win.turnstile || form.dataset.widget) return;
      form.dataset.widget = win.turnstile.render(el, {sitekey:el.dataset.sitekey, action:'newsletter', callback:(token: string)=>{form.dataset.captcha=token;}, 'expired-callback':()=>{delete form.dataset.captcha;}, 'error-callback':()=>{delete form.dataset.captcha;}});
    });
  };
  if (win.turnstile) loadCaptcha();
  else { const script = document.createElement('script'); script.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'; script.async=true; script.onload=loadCaptcha; document.head.append(script); }
  forms.forEach(form => form.addEventListener('submit', async event => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const status = form.querySelector<HTMLElement>('[data-newsletter-status]')!;
    if (button.disabled || !form.reportValidity()) return;
    if (!form.dataset.captcha) {status.textContent='Please complete the security check.'; return;}
    button.disabled=true; status.textContent='Sending confirmation…';
    const placement = form.dataset.placement || 'newsletter-page';
    win.rwaAnalytics?.track('newsletter_submit','newsletter',{placement});
    try {
      const fields = new FormData(form);
      const result = await fetch(form.dataset.endpoint!, {method:'POST', headers:{'content-type':'application/json'}, credentials:'omit', signal:AbortSignal.timeout(15000), body:JSON.stringify({action:'subscribe', email:fields.get('email'), consent:fields.get('consent')==='on', website:fields.get('website'), placement, captcha:form.dataset.captcha})});
      const data = await result.json();
      if (!result.ok || data.code !== 'check_email') throw new Error(result.status===429?'rate_limited':'unavailable');
      status.textContent='If confirmation is needed, an email is on its way. Check your inbox and spam folder. You are subscribed only after confirming.';
      form.reset(); win.rwaAnalytics?.track('newsletter_pending','newsletter',{placement});
    } catch(error) {
      status.textContent=error instanceof Error && error.message==='rate_limited'?'Too many requests. Please try again tomorrow.':'Signup is temporarily unavailable. Please try again later.';
      win.rwaAnalytics?.track('newsletter_error','newsletter',{placement});
    } finally {button.disabled=false; delete form.dataset.captcha; if(form.dataset.widget) win.turnstile?.reset(form.dataset.widget);}
  }));
}
</script>
