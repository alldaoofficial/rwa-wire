---
interface Props {
  name: string;
  description: string;
  href: string;
}
const { name, description, href } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col justify-between border border-line p-6 transition-colors hover:border-wire/40"
>
  <div>
    <h3 class="font-serif text-lg font-medium text-ink">{name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-muted">{description}</p>
  </div>
  <span class="mt-6 text-xs font-medium uppercase tracking-[0.08em] text-ink-muted group-hover:text-wire">
    Open calculator
  </span>
</a>
