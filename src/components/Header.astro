---
import { sitePath } from "../utils/paths";
import Logo from "@/components/Logo.astro";
import MobileMenu from "@/components/MobileMenu.astro";
import { NAV_LINKS, TELEGRAM_URL } from "@/config/site";

const path = Astro.url.pathname;
function isActive(href: string) {
  return path === sitePath(href) || (href !== "/" && path.startsWith(sitePath(href)));
}
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/90 backdrop-blur">
  <div class="wire-container flex h-[57px] items-center justify-between gap-6">
    <a href={sitePath("/")} class="shrink-0">
      <Logo size="sm" />
    </a>

    <nav class="hidden flex-1 items-center justify-center gap-6 md:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={sitePath(link.href)}
            class:list={[
              "text-xs font-medium uppercase tracking-[0.08em] text-ink-muted hover:text-ink",
              isActive(link.href) && "text-ink",
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={TELEGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 rounded border border-line px-3.5 py-1.5 text-xs font-medium uppercase tracking-[0.08em] text-ink transition-colors hover:border-wire/50 hover:text-wire sm:inline-flex"
      >
        Telegram
      </a>
      <MobileMenu />
    </div>
  </div>
</header>
