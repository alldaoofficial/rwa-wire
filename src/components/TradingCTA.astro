---
import { sitePath } from "../utils/paths";
import { AFFILIATE_URL, AFFILIATE_PARTNER_NAME } from "@/config/site";
---

<aside class="border border-line p-6" aria-label="Trading partner">
  <p class="eyebrow text-wire">Trading partner</p>
  <h2 class="mt-2 font-serif text-xl text-ink">Want to trade the crypto market?</h2>
  <p class="mt-3 text-sm leading-relaxed text-ink-muted">
    Explore {AFFILIATE_PARTNER_NAME} if you are looking for a crypto trading platform.
    RWA Wire has an affiliate partnership with {AFFILIATE_PARTNER_NAME}; if you open
    an account through our link, we may earn a commission at no extra cost to you.
    Availability and product access depend on your jurisdiction. This is not investment advice.
  </p>
  <div class="mt-4 flex flex-wrap items-center gap-4">
    <a
      href={AFFILIATE_URL}
      target="_blank"
      rel="noopener noreferrer sponsored"
      data-analytics-placement="article-trading-cta"
      class="inline-flex rounded bg-wire px-5 py-2.5 text-sm font-semibold text-bg hover:bg-wire/90"
    >
      Explore {AFFILIATE_PARTNER_NAME} →
    </a>
    <a href={sitePath("/affiliate-disclosure/")} class="text-xs text-ink-muted underline hover:text-wire">
      Affiliate disclosure
    </a>
  </div>
</aside>
