---
import { sitePath } from "../utils/paths";
import { AFFILIATE_PARTNER_NAME } from "@/config/site";
---

<aside class="border border-line bg-surface p-6" aria-label="Trading platform guide">
  <p class="eyebrow text-wire">RWA Wire // Platform guide</p>
  <h2 class="mt-2 font-serif text-xl text-ink">Looking for a crypto trading platform?</h2>
  <p class="mt-3 text-sm leading-relaxed text-ink-muted">
    Read our practical {AFFILIATE_PARTNER_NAME} guide before opening an account. We cover standard fees,
    futures and copy trading, plus the risks and checks that matter. RWA Wire has an affiliate partnership
    with {AFFILIATE_PARTNER_NAME} and may earn a commission if you later register through our partner link.
  </p>
  <div class="mt-4 flex flex-wrap items-center gap-4">
    <a
      href={sitePath("/bitunix/")}
      data-analytics-placement="article-bitunix-guide"
      class="inline-flex rounded bg-wire px-5 py-2.5 text-sm font-semibold text-bg hover:bg-wire/90"
    >
      Read the {AFFILIATE_PARTNER_NAME} guide →
    </a>
    <a href={sitePath("/affiliate-disclosure/")} class="text-xs text-ink-muted underline hover:text-wire">
      Affiliate disclosure
    </a>
  </div>
  <p class="mt-4 text-[11px] leading-5 text-ink-muted">Crypto and derivatives trading involve substantial risk. Availability varies by jurisdiction.</p>
</aside>
